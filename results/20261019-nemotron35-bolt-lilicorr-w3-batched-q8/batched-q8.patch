+
+// One independent work-group per (row pair, activation column). The shared
+// body retains the singleton stripe order and both stages of its reduction.
+template <int WG>
+static void q8_0_esimd_launch_batched(const void * vx, const float * y, float * dst,
+                                     const int ncols, const int nrows, const int nvectors,
+                                     const int64_t y_stride, const int64_t dst_stride,
+                                     dpct::queue_ptr stream) {
+    const int workgroups = (nrows + 1) / 2;
+    stream->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> lmem(sycl::range<1>(WG * 2), h);
+        h.parallel_for(
+            sycl::nd_range<2>(sycl::range<2>((size_t) workgroups * WG, (size_t) nvectors),
+                              sycl::range<2>(WG, 1)),
+            [=](sycl::nd_item<2> it) [[intel::sycl_explicit_simd]] {
+                const int64_t col = it.get_group(1);
+                dequantize_mul_mat_vec_q8_0_reorder_esimd<WG>(
+                    vx, y + col * y_stride, dst + col * dst_stride, ncols, nrows, lmem, it);
+            });
+    });
+}
+
+void ggml_sycl_dequantize_mul_mat_vec_q8_0_batched(
+        const void * vx, const float * y, float * dst, const int ncols, const int nrows,
+        const int nvectors, const int64_t y_stride, const int64_t dst_stride,
+        dpct::queue_ptr stream) {
+    GGML_ASSERT(ncols % QK8_0 == 0);
+    GGML_ASSERT(nvectors >= 3 && nvectors <= 8);
+
+    // Exactly the singleton WG selection, not an MMVQ/Q4_K crossover.
+    const int nblk_row = ncols / QK8_0;
+    if (nblk_row >= 64) {
+        q8_0_esimd_launch_batched<8>(vx, y, dst, ncols, nrows, nvectors, y_stride, dst_stride, stream);
+    } else if (nblk_row >= 32) {
+        q8_0_esimd_launch_batched<4>(vx, y, dst, ncols, nrows, nvectors, y_stride, dst_stride, stream);
+    } else if (nblk_row >= 16) {
+        q8_0_esimd_launch_batched<2>(vx, y, dst, ncols, nrows, nvectors, y_stride, dst_stride, stream);
+    } else {
+        q8_0_esimd_launch_batched<1>(vx, y, dst, ncols, nrows, nvectors, y_stride, dst_stride, stream);
     }
 }
 
