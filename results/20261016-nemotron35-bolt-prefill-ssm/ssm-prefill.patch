+static bool ssm_scan_prefill_supported(ggml_backend_sycl_context & ctx, const ggml_tensor * dst) {
+    const ggml_tensor * s  = dst->src[0];
+    const ggml_tensor * x  = dst->src[1];
+    const ggml_tensor * dt = dst->src[2];
+    const ggml_tensor * A  = dst->src[3];
+    const ggml_tensor * B  = dst->src[4];
+    const int64_t nh = x->ne[1], nt = x->ne[2], ns = x->ne[3], ng = B->ne[1];
+    const int64_t K = ggml_get_op_params_i32(dst, 0);
+
+    // Bolt and the small native controls only. Decode always uses the original kernel.
+    if (!g_ggml_sycl_enable_fusion || nt < 2 || nt > 1024 || K < 1 || K > 4 ||
+        s->ne[0] != 128 || s->ne[1] != 64 || x->ne[0] != 64 || A->ne[0] != 1 ||
+        !((nh == 128 && ng == 8 && ns == 1) ||
+          (nh == 16 && ng == 2 && ns == 2) ||
+          (nh == 4 && (ng == 1 || ng == 4) && (ns == 1 || ns == 2)))) {
+        return false;
+    }
+
+    // The VMM pool only rewinds its allocation cursor on release: backing storage
+    // stays mapped. Later reuse on this same in-order queue follows the scan. Do not
+    // use the legacy pool here: its full-cache eviction can immediately free USM.
+#if defined(GGML_SYCL_SUPPORT_VMM)
+    extern int g_ggml_sycl_enable_vmm;
+    if (!g_ggml_sycl_enable_vmm || !ggml_sycl_info().devices[ctx.device].vmm) {
+        return false;
+    }
+#else
+    GGML_UNUSED(ctx);
+    return false;
+#endif
+    if (!ctx.stream()->is_in_order() || !ggml_is_contiguous(dst) ||
+        !ggml_is_contiguous(s) || !ggml_is_contiguous(dt) || !ggml_is_contiguous(A) ||
+        !ggml_is_contiguous(dst->src[6]) ||
+        s->nb[0] != sizeof(float) || s->nb[1] != 128 * sizeof(float) ||
+        s->nb[2] != 128 * 64 * sizeof(float) || s->nb[3] != 128 * 64 * nh * sizeof(float)) {
+        return false;
+    }
+    for (int j = 0; j < 7; ++j) {
+        const ggml_tensor * t = dst->src[j];
+        if (t->type != (j == 6 ? GGML_TYPE_I32 : GGML_TYPE_F32) || ggml_nbytes(t) > INT32_MAX) {
+            return false;
+        }
+        // Both kernels require independent output storage. Read-only input/input
+        // overlap is harmless; never let staging move a read across an output write.
+        const uintptr_t a = reinterpret_cast<uintptr_t>(dst->data);
+        const uintptr_t b = reinterpret_cast<uintptr_t>(t->data);
+        if (a <= b ? b - a < ggml_nbytes(dst) : a - b < ggml_nbytes(t)) {
+            return false;
+        }
+    }
+    for (int j : { 1, 4, 5 }) {
+        const ggml_tensor * t = dst->src[j];
+        // Contiguous channel/group planes, optionally padded token/sequence strides.
+        // Axis-permuted layouts stay on the original path even when it supports them.
+        if (t->nb[0] != sizeof(float) || t->nb[1] != t->ne[0] * sizeof(float) ||
+            t->nb[2] < t->nb[1] * t->ne[1] || t->nb[3] < t->nb[2] * t->ne[2] ||
+            t->nb[2] > INT32_MAX || t->nb[3] > INT32_MAX ||
+            t->nb[2] % sizeof(float) != 0 || t->nb[3] % sizeof(float) != 0) {
+            return false;
+        }
+    }
+    return true;
+}
