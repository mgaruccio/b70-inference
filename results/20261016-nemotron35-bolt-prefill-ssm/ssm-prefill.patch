+static void ggml_sycl_ssm_scan_prefill(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/7);
+    const ggml_tensor * s = dst->src[0], * x = dst->src[1], * dt = dst->src[2];
+    const ggml_tensor * A = dst->src[3], * B = dst->src[4], * C = dst->src[5];
+    const int64_t nh = x->ne[1], nt = x->ne[2], ns = x->ne[3], ng = B->ne[1];
+    const int64_t K = ggml_get_op_params_i32(dst, 0);
+    const int64_t s_off = ggml_nelements(x) * sizeof(float);
+    const size_t count = nh * nt * ns;
+    dpct::queue_ptr stream = ctx.stream();
+    // One allocation, alive through both submissions. At most 1 MiB for Bolt.
+    ggml_sycl_pool_alloc<float> transforms(ctx.pool(), 2 * count);
+    float * softplus = transforms.get();
+    float * decay = softplus + count;
+    const float * dt_data = static_cast<const float *>(dt->data);
+    const float * A_data = static_cast<const float *>(A->data);
+    constexpr size_t threads = 128;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((count + threads - 1) / threads * threads), sycl::range<1>(threads)),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const size_t i = item.get_global_id(0);
+            if (i >= count) { return; }
+            const float dt_val = dt_data[i];
+            const float dt_soft_plus = (dt_val <= 20.0f ? sycl::log1p(sycl::exp(dt_val)) : dt_val);
+            softplus[i] = dt_soft_plus;
+            decay[i] = sycl::exp(dt_soft_plus * A_data[i % nh]);
+        });
+
+    const float * s_data = static_cast<const float *>(s->data);
+    const float * x_data = static_cast<const float *>(x->data);
+    const float * B_data = static_cast<const float *>(B->data);
+    const float * C_data = static_cast<const float *>(C->data);
+    const int32_t * ids = static_cast<const int32_t *>(dst->src[6]->data);
+    float * out = static_cast<float *>(dst->data);
+    const int s_nb2 = s->nb[2], s_nb3 = s->nb[3], x_nb2 = x->nb[2], x_nb3 = x->nb[3];
+    const int B_nb2 = B->nb[2], B_nb3 = B->nb[3], C_nb2 = C->nb[2], C_nb3 = C->nb[3];
+    constexpr int num_warps = threads / WARP_SIZE;
+    const sycl::range<2> grid(ns, (nh * 64 + num_warps - 1) / num_warps);
+    const sycl::range<2> block(1, threads);
+    stream->parallel_for(
+        sycl::nd_range<2>(grid * block, block),
+        [=](sycl::nd_item<2> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            ssm_scan_f32_group_prefill<128 / WARP_SIZE, 128>(
+                s_data, x_data, softplus, decay, B_data, C_data, ids, out,
+                s_nb2, s_nb3, x_nb2, x_nb3, B_nb2, B_nb3, C_nb2, C_nb3,
+                s_off, nh, 64, ng, nt, K, item);
+        });
+}
