+// Bolt staged-prefill contract: full arrays, not a reduced scalar or a sampled delta.
+struct test_bolt_ssm_prefill : public test_case {
+    const int64_t n_seq_tokens, n_head, n_group, n_seqs, K, d_state, head_dim;
+    const std::string layout;
+
+    test_bolt_ssm_prefill(int64_t nt, int64_t nh = 4, int64_t ng = 1, int64_t ns = 1,
+                          int64_t k = 1, const char * layout = "contiguous",
+                          int64_t ds = 128, int64_t hd = 64) :
+        n_seq_tokens(nt), n_head(nh), n_group(ng), n_seqs(ns), K(k), d_state(ds), head_dim(hd), layout(layout) {}
+
+    std::string op_desc(ggml_tensor *) override { return "BOLT_SSM_PREFILL"; }
+    std::string vars() override {
+        return VARS_TO_STR8(n_seq_tokens, n_head, n_group, n_seqs, K, d_state, head_dim, layout);
+    }
+    bool run_whole_graph() override { return true; }
+
+    size_t y_elems() const { return head_dim * n_head * n_seq_tokens * n_seqs; }
+    size_t state_elems() const { return d_state * head_dim * n_head * n_seqs; }
+
+    ggml_tensor * input(ggml_context * ctx, int64_t d0, int64_t d1, const char * name) {
+        ggml_tensor * t;
+        if (layout == "padded") {
+            // Independent read-only backing allocations, with token/sequence gaps
+            // and a nonzero offset. Never alias scan output or mutable CPU state.
+            ggml_tensor * storage = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, d0, d1 + 1, n_seq_tokens + 1, n_seqs);
+            ggml_format_name(storage, "%s_storage", name);
+            t = ggml_view_4d(ctx, storage, d0, d1, n_seq_tokens, n_seqs,
+                             storage->nb[1], storage->nb[2], storage->nb[3], sizeof(float));
+        } else if (layout == "permuted") {
+            ggml_tensor * storage = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, d0, d1, n_seqs, n_seq_tokens);
+            ggml_format_name(storage, "%s_storage", name);
+            t = ggml_permute(ctx, storage, 0, 1, 3, 2);
+        } else {
+            t = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, d0, d1, n_seq_tokens, n_seqs);
+        }
+        ggml_set_name(t, name);
+        return t;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t cache_rows = n_seqs + (layout == "gather" ? 3 : layout == "duplicate_ids" ? 2 : 0);
+        ggml_tensor * s = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, d_state, head_dim, n_head, cache_rows);
+        ggml_tensor * x = input(ctx, head_dim, n_head, "prefill_x");
+        ggml_tensor * dt = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_head, n_seq_tokens, n_seqs);
+        ggml_tensor * A = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_head);
+        ggml_tensor * B = input(ctx, d_state, n_group, "prefill_B");
+        ggml_tensor * C = input(ctx, d_state, n_group, "prefill_C");
+        ggml_tensor * ids = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_seqs);
+        ggml_set_name(s, "prefill_s");
+        ggml_set_name(dt, "prefill_dt");
+        ggml_set_name(A, "prefill_A");
+        ggml_set_name(ids, "prefill_ids");
+
+        // K=5 is outside the staged dispatch. In the original kernel, K only guards
+        // snapshot stores: the complete y and the first K<=5 state slots are the
+        // same computation. This forces a same-backend original-kernel reference
+        // without changing a global environment variable or inventing a test flag.
+        GGML_ASSERT(K <= 5);
+        ggml_tensor * ref = ggml_ssm_scan(ctx, s, x, dt, A, B, C, ids, 5);
+        ggml_set_name(ref, "prefill_scan_reference");
+        ggml_build_forward_expand(gf, ref);
+        ggml_tensor * out = ggml_ssm_scan(ctx, s, x, dt, A, B, C, ids, K);
+        ggml_set_name(out, "prefill_scan_candidate");
+        // No arithmetic between scan and readback: concat preserves signed zero
+        // and every F32 bit, including unwritten K>nt canaries. The reference's
+        // extra slots are not candidate output; ALL candidate slots are compared.
+        ggml_tensor * ref_prefix = ggml_view_1d(ctx, ref, ggml_nelements(out), 0);
+        ggml_tensor * pair = ggml_concat(ctx, out, ref_prefix, 0);
+        ggml_set_name(pair, "prefill_full_array_pair");
+        return pair;
+    }
+
+    static float canary(size_t i) { return float(1 + i % 31) / 64.0f; }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) { continue; }
+            if (t->type == GGML_TYPE_I32) {
+                std::vector<int32_t> data(n_seqs);
+                for (int64_t i = 0; i < n_seqs; ++i) {
+                    data[i] = layout == "gather" ? n_seqs + 2 :
+                              layout == "duplicate_ids" ? n_seqs : n_seqs - 1 - i;
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, data.size() * sizeof(int32_t));
+                continue;
+            }
+            uint32_t salt = 0;
+            for (const char * p = t->name; *p; ++p) { salt = salt * 33 + uint8_t(*p); }
+            std::vector<float> data(ggml_nelements(t));
+            for (size_t i = 0; i < data.size(); ++i) {
+                data[i] = (int((i * 17 + salt) % 257) - 128) / 1024.0f;
+                if (strncmp(t->name, "prefill_scan_", 13) == 0) {
+                    data[i] = canary(i); // identical candidate/reference unused-slot contents
+                } else if (strcmp(t->name, "prefill_A") == 0) {
+                    const float edge_A[] = { -0.0f, -0.0001f, -0.5f, -8.0f };
+                    data[i] = layout == "edges" ? edge_A[i % 4] : -0.5f - float(i % 17) / 32.0f;
+                } else if (strcmp(t->name, "prefill_dt") == 0) {
+                    const float edge_dt[] = { -104.0f, -90.0f, -80.0f, -20.0f, -1.0f, -0.0f, 0.0f,
+                                             0x1p-149f, 1.0f, 0x1.3ffffep+4f, 20.0f, 0x1.400002p+4f, 80.0f };
+                    data[i] = layout == "edges" ? edge_dt[i % 13] : float(int(i % 33) - 16) / 4.0f;
+                }
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, data.size() * sizeof(float));
+        }
+    }
+
+    static uint32_t bits(float v) {
+        uint32_t u;
+        memcpy(&u, &v, sizeof(u));
+        return u;
+    }
+
+    bool exact_pair(const float * data, const char * backend) {
+        const size_t ny = y_elems(), ns = state_elems(), total = ny + K * ns;
+        size_t bad_y = 0, bad_state = 0, bad_canary = 0, first = total;
+        for (size_t i = 0; i < total; ++i) {
+            if (bits(data[i]) != bits(data[total + i])) {
+                ++(i < ny ? bad_y : bad_state);
+                if (first == total) { first = i; }
+            }
+            if (i >= ny + std::min(K, n_seq_tokens) * ns &&
+                (bits(data[i]) != bits(canary(i)) || bits(data[total + i]) != bits(canary(i)))) {
+                ++bad_canary;
+                if (first == total) { first = i; }
+            }
+        }
+        printf("[BOLT_SSM_PREFILL] backend=%s y_words=%zu state_words=%zu "
+               "y_mismatches=%zu state_mismatches=%zu canary_mismatches=%zu case=(%s)\n",
+               backend, ny, K * ns, bad_y, bad_state, bad_canary, vars().c_str());
+        if (first != total) {
+            printf("[BOLT_SSM_PREFILL_MISMATCH] backend=%s index=%zu region=%s "
+                   "candidate=0x%08" PRIx32 " reference=0x%08" PRIx32 "\n",
+                   backend, first, first < ny ? "y" : "state", bits(data[first]), bits(data[total + first]));
+            return false;
+        }
+        return true;
+    }
+
+    double err(const float * a, const float * b, size_t n) override {
+        const size_t ny = y_elems(), ns = state_elems(), total = ny + K * ns;
+        if (n != 2 * total) {
+            printf("[BOLT_SSM_PREFILL_MISMATCH] incomplete comparison: got=%zu expected=%zu\n", n, 2 * total);
+            return 1.0;
+        }
+        const bool exact_a = exact_pair(a, "under_test");
+        const bool exact_b = exact_pair(b, "CPU");
+        if (!exact_a || !exact_b) { return 1.0; }
+        // Keep the default 1e-7 CPU NMSE limit, separately for y and EACH complete
+        // state slot (including unwritten slots), for both halves. No dilution by
+        // the other array or the initialized rollback canaries is allowed.
+        double result = 0.0;
+        for (size_t half : { size_t(0), total }) {
+            for (int64_t part = 0; part <= K; ++part) {
+                const size_t off = half + (part == 0 ? 0 : ny + (part - 1) * ns);
+                const size_t len = part == 0 ? ny : ns;
+                if (memcmp(a + off, b + off, len * sizeof(float)) == 0) { continue; }
+                const double e = test_case::err(a + off, b + off, len);
+                if (!std::isfinite(e)) { return 1.0; }
+                result = std::max(result, e);
+            }
+        }
+        return result;
+    }
+};
