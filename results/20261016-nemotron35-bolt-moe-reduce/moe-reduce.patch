+// Nine-expert SYCL reduction: CPU tolerance stays at test_case's 1e-7.
+// Each case also compares its entire result bit-for-bit with a same-backend
+// control whose MUL and ADD intermediates are outputs (and cannot be elided).
+struct test_moe_reduce_9 : public test_case {
+    const int64_t n_embd;
+    const int64_t n_tokens;
+    const bool sensitive;
+    const std::string guard;
+    ggml_tensor * expert_storage = nullptr;
+    ggml_tensor * weight_storage = nullptr;
+    std::vector<ggml_tensor *> verified;
+
+    test_moe_reduce_9(int64_t n_embd, int64_t n_tokens, bool sensitive, const char * guard = "none") :
+        n_embd(n_embd), n_tokens(n_tokens), sensitive(sensitive), guard(guard) {}
+
+    std::string vars() override { return VARS_TO_STR4(n_embd, n_tokens, sensitive, guard); }
+    std::string op_desc(ggml_tensor *) override { return "MOE_REDUCE_9"; }
+    bool run_whole_graph() override { return true; }
+    std::vector<ggml_tensor *> fusion_test_nodes() override {
+        auto nodes = verified;
+        nodes.insert(nodes.end(), sentinels.begin(), sentinels.end());
+        return nodes;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        verified.clear();
+        const int n_experts = guard == "eight" ? 8 : 9;
+        expert_storage = ggml_new_tensor_3d(ctx, GGML_TYPE_F32,
+            n_embd + (guard == "strided_experts"), n_experts, n_tokens);
+        weight_storage = ggml_new_tensor_3d(ctx, GGML_TYPE_F32,
+            guard == "strided_weights" ? 2 : 1, n_experts, n_tokens);
+        ggml_tensor * experts = expert_storage;
+        ggml_tensor * weights = weight_storage;
+        if (guard == "strided_experts") {
+            experts = ggml_view_3d(ctx, expert_storage, n_embd, n_experts, n_tokens,
+                expert_storage->nb[1], expert_storage->nb[2], 0);
+        }
+        if (guard == "strided_weights") {
+            weights = ggml_view_3d(ctx, weight_storage, 1, n_experts, n_tokens,
+                weight_storage->nb[1], weight_storage->nb[2], 0);
+        }
+
+        const auto expand = [this](ggml_tensor * t) {
+            if (mode == MODE_TEST) {
+                ggml_build_forward_expand(gf, t);
+            }
+        };
+        const auto reduction = [&](bool control) {
+            ggml_tensor * weighted = ggml_mul(ctx, experts, weights);
+            ggml_format_name(weighted, "%s_weighted", control ? "control" : "candidate");
+            if (control) {
+                ggml_set_output(weighted);
+            }
+            expand(weighted);
+            std::vector<ggml_tensor *> views;
+            for (int expert = 0; expert < n_experts; ++expert) {
+                int row = expert;
+                if (guard == "shuffled_views" && (expert == 3 || expert == 4)) {
+                    row = 7 - expert;
+                }
+                views.push_back(ggml_view_2d(ctx, weighted, n_embd, n_tokens,
+                    weighted->nb[2], row * weighted->nb[1]));
+                expand(views.back());
+            }
+            ggml_tensor * out = guard == "right_associated" ? views.back() : views.front();
+            ggml_tensor * middle = nullptr;
+            for (int step = 1; step < n_experts; ++step) {
+                if (guard == "right_associated") {
+                    out = ggml_add(ctx, views[n_experts - 1 - step], out);
+                } else if (!control && guard == "inplace" && step == n_experts - 1) {
+                    out = ggml_add_inplace(ctx, out, views[step]);
+                } else {
+                    out = ggml_add(ctx, out, views[step]);
+                }
+                if (control) {
+                    ggml_set_output(out);
+                }
+                if (step == 4) {
+                    middle = out;
+                }
+                expand(out);
+            }
+            ggml_format_name(out, "%s_reduce", control ? "control" : "candidate");
+            // Consumers are deliberately appended AFTER the complete candidate
+            // window, so use-count/output checks, not an op-sequence mismatch,
+            // have to protect the elided values.
+            if (!control) {
+                ggml_tensor * observed = nullptr;
+                if (guard == "consumer_mul" || guard == "output_mul") {
+                    observed = weighted;
+                } else if (guard == "consumer_view" || guard == "output_view") {
+                    observed = views[3];
+                } else if (guard == "consumer_add" || guard == "output_add") {
+                    observed = middle;
+                }
+                if (observed) {
+                    if (guard.find("consumer_") == 0) {
+                        observed = ggml_scale(ctx, observed, 0.5f);
+                    } else {
+                        ggml_set_output(observed);
+                    }
+                    expand(observed);
+                    verified.push_back(observed);
+                }
+            }
+            return out;
+        };
+        ggml_tensor * candidate = reduction(false);
+        ggml_tensor * control = reduction(true);
+        ggml_tensor * out = ggml_concat(ctx, candidate, control, 1);
+        ggml_set_name(out, "candidate_and_unfused_control");
+        verified.push_back(out);
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->view_src) {
+                continue;
+            }
+            GGML_ASSERT(t->type == GGML_TYPE_F32);
+            std::vector<float> data(ggml_nelements(t), 0.25f);
+            for (size_t i = 0; i < data.size(); ++i) {
+                const uint32_t bits = (uint32_t) i * 1664525u + 1013904223u;
+                if (t == weight_storage) {
+                    const int expert = (i / t->ne[0]) % t->ne[1];
+                    data[i] = sensitive ? (expert == 1 ? 1.0f - 0x1p-13f : 1.0f) :
+                        (float) (1 + (bits >> 16)) / (65536.0f * 9.0f);
+                } else if (t == expert_storage) {
+                    const int expert = (i / t->ne[0]) % t->ne[1];
+                    const size_t col = i % t->ne[0];
+                    data[i] = (float) ((int32_t) (bits >> 8) - 8388608) / 8388608.0f;
+                    if (sensitive) {
+                        switch (col % 4) {
+                            case 0:
+                                // Separate MUL rounds (1+2^-13)*(1-2^-13) to 1;
+                                // contraction with the initial -1 instead gives -2^-26.
+                                data[i] = expert == 0 ? -1.0f : expert == 1 ? 1.0f + 0x1p-13f : 0.0f;
+                                break;
+                            case 1:
+                                data[i] = expert == 2 ? 16777216.0f : expert == 3 ? -16777216.0f :
+                                          expert == 4 ? 1.0f : 0.0f;
+                                break;
+                            case 2:
+                                data[i] = expert == 0 ? 1.0e8f : expert == 1 ? 1.0f :
+                                          expert == 2 ? -1.0e8f : 0.0f;
+                                break;
+                            default: break;
+                        }
+                    }
+                }
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
+        }
+    }
+
+    double err(const float * a, const float * b, size_t n) override {
+        const size_t half = (size_t) n_embd * n_tokens;
+        if (n == 2 * half) {
+            size_t mismatches = 0;
+            float max_abs = 0.0f;
+            for (size_t i = 0; i < half; ++i) {
+                mismatches += memcmp(a + i, a + half + i, sizeof(float)) != 0;
+                max_abs = std::max(max_abs, std::abs(a[i] - a[half + i]));
+            }
+            printf("MOE_REDUCE_9 full-array: mismatches=%zu max_abs=%.9g ", mismatches, max_abs);
+            if (mismatches != 0) {
+                return INFINITY;
+            }
+        }
+        return test_case::err(a, b, n);
+    }
+};
