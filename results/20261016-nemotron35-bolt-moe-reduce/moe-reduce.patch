diff --git a/ggml/src/ggml-sycl/topk-moe.cpp b/ggml/src/ggml-sycl/topk-moe.cpp
--- a/ggml/src/ggml-sycl/topk-moe.cpp
+++ b/ggml/src/ggml-sycl/topk-moe.cpp
@@ -539,11 +539,113 @@
     return is_ok;
 }
 
+// Only the nine-expert, all-views-before-adds graph emitted by build_moe_ffn.
+// A preceding expert-scale MUL, if present, remains a separate operation.
+static int ggml_sycl_fuse_moe_weighted_reduce(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i) {
+    constexpr int n_experts = 9;
+    constexpr int node_count = 2 * n_experts; // MUL, nine VIEWs, eight ordered ADDs
+    const ggml_tensor * weighted = cgraph->nodes[i];
+    if (weighted->op != GGML_OP_MUL || weighted->type != GGML_TYPE_F32 || weighted->view_src ||
+        !ggml_is_contiguous(weighted) || weighted->ne[0] <= 0 || weighted->ne[1] != n_experts ||
+        weighted->ne[2] <= 0 || weighted->ne[3] != 1 || cgraph->n_nodes - i < node_count) {
+        return 0;
+    }
+
+    const ggml_tensor * experts = weighted->src[0];
+    const ggml_tensor * weights = weighted->src[1];
+    if (!experts || !weights || experts->type != GGML_TYPE_F32 || weights->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(experts) || !ggml_is_contiguous(weights) ||
+        !ggml_are_same_shape(experts, weighted) || weights->ne[0] != 1 ||
+        weights->ne[1] != n_experts || weights->ne[2] != weighted->ne[2] || weights->ne[3] != 1) {
+        return 0;
+    }
+
+    ggml_op ops[node_count];
+    ops[0] = GGML_OP_MUL;
+    for (int expert = 0; expert < n_experts; ++expert) {
+        const ggml_tensor * view = cgraph->nodes[i + 1 + expert];
+        ops[1 + expert] = GGML_OP_VIEW;
+        if (view->op != GGML_OP_VIEW || view->src[0] != weighted || view->view_src != weighted ||
+            view->type != GGML_TYPE_F32 || view->ne[0] != weighted->ne[0] ||
+            view->ne[1] != weighted->ne[2] || view->ne[2] != 1 || view->ne[3] != 1 ||
+            view->nb[0] != sizeof(float) || view->nb[1] != weighted->nb[2] ||
+            view->view_offs != (size_t) expert * weighted->nb[1]) {
+            return 0;
+        }
+    }
+
+    const ggml_tensor * previous = cgraph->nodes[i + 1];
+    for (int expert = 1; expert < n_experts; ++expert) {
+        const int offset = n_experts + expert;
+        const ggml_tensor * add = cgraph->nodes[i + offset];
+        ops[offset] = GGML_OP_ADD;
+        if (add->op != GGML_OP_ADD || add->src[0] != previous ||
+            add->src[1] != cgraph->nodes[i + 1 + expert] || add->type != GGML_TYPE_F32 ||
+            add->view_src || !ggml_is_contiguous(add) || add->ne[0] != weighted->ne[0] ||
+            add->ne[1] != weighted->ne[2] || add->ne[2] != 1 || add->ne[3] != 1) {
+            return 0;
+        }
+        previous = add;
+    }
+
+    const int output_idx = i + node_count - 1;
+    ggml_tensor * dst = cgraph->nodes[output_idx];
+    // The shared graph helper checks compute/output flags, external consumers,
+    // and external view sources for every elided node, including the nine views.
+    if (!ggml_can_fuse_subgraph(cgraph, i, node_count, ops, &output_idx, 1) ||
+        !experts->data || !weights->data || !dst->data) {
+        return 0;
+    }
+    // Unlike the top-k helper above, include GGML_OP_NONE inputs: a leaf can
+    // alias the destination too. Only these two contiguous tensors are read.
+    const auto overlaps_dst = [dst](const ggml_tensor * src) {
+        const uintptr_t a = (uintptr_t) dst->data;
+        const uintptr_t b = (uintptr_t) src->data;
+        return a <= b ? b - a < ggml_nbytes(dst) : a - b < ggml_nbytes(src);
+    };
+    if (overlaps_dst(experts) || overlaps_dst(weights)) {
+        return 0;
+    }
+
+    const scope_op_debug_print log("ggml_sycl_op_moe_weighted_reduce", dst, 0);
+    const float * expert_data = (const float *) experts->data;
+    const float * weight_data = (const float *) weights->data;
+    float * out = (float *) dst->data;
+    const size_t width = (size_t) experts->ne[0];
+    const size_t tokens = (size_t) experts->ne[2];
+    constexpr size_t threads = 256;
+    ctx.stream()->parallel_for(
+        sycl::nd_range<2>(sycl::range<2>(tokens, ((width + threads - 1) / threads) * threads),
+                          sycl::range<2>(1, threads)),
+        [=](sycl::nd_item<2> item) {
+            // Preserve the standalone F32 MUL rounding and left-to-right ADDs.
+            // Scoped to this kernel, not the translation unit or other fusions.
+#pragma clang fp contract(off) reassociate(off)
+            const size_t token = item.get_global_id(0);
+            const size_t col = item.get_global_id(1);
+            if (col >= width) {
+                return;
+            }
+            const size_t first_row = token * n_experts;
+            float sum = expert_data[first_row * width + col] * weight_data[first_row];
+            for (int expert = 1; expert < n_experts; ++expert) {
+                const size_t row = first_row + expert;
+                const float product = expert_data[row * width + col] * weight_data[row];
+                sum = sum + product;
+            }
+            out[token * width + col] = sum;
+        });
+    return node_count - 1;
+}
+
 int ggml_sycl_fuse(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i) {
     if (!g_ggml_sycl_enable_fusion) {
         return 0;
     }
 
+    if (const int skip = ggml_sycl_fuse_moe_weighted_reduce(ctx, cgraph, i)) {
+        return skip;
+    }
     return ggml_sycl_fuse_topk_moe(ctx, cgraph, i);
 }
 
