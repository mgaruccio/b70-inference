+// SSM_SCAN -> exact final-state cache CPY. Unlike GDN, y remains live in the scan output.
+// Only the final-state tail may be elided. Keep all other graphs on the ordinary path.
+static int ggml_sycl_try_ssm_scan_cache_fusion(const ggml_cgraph * cgraph, int node_idx, float * & cache) {
+    const ggml_tensor * ssm = cgraph->nodes[node_idx];
+    if (!g_ggml_sycl_enable_fusion || ssm->op != GGML_OP_SSM_SCAN || ssm->type != GGML_TYPE_F32 ||
+        (ssm->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_get_op_params_i32(ssm, 0) != 1) {
+        return 0;
+    }
+
+    const ggml_tensor * s = ssm->src[0];
+    const ggml_tensor * x = ssm->src[1];
+    const ggml_tensor * A = ssm->src[3];
+    // Multiple sequences could read each other's cache rows in the same launch. K > 1,
+    // Mamba-1 and other state sizes deliberately retain the existing scan + CPY.
+    if (s->type != GGML_TYPE_F32 || s->ne[0] != 128 || !ggml_is_contiguous(s) ||
+        x->ne[3] != 1 || x->ne[2] < 1 || s->ne[1] % WARP_SIZE != 0 ||
+        A->ne[0] != 1 || A->nb[1] != sizeof(float)) {
+        return 0;
+    }
+    const int64_t D = s->ne[0] * s->ne[1] * s->ne[2];
+    const size_t state_bytes = ggml_row_size(GGML_TYPE_F32, D);
+    const size_t tail_off = ggml_row_size(GGML_TYPE_F32, ggml_nelements(x));
+
+    // Match exactly what graph_compute_impl skips. Never move the cache write across a launch.
+    const ggml_tensor * cpy = nullptr;
+    int cpy_idx = node_idx;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_sycl_is_view_or_noop(n) || (n->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        if (n->op != GGML_OP_CPY || (n->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return 0;
+        }
+        cpy = n;
+        cpy_idx = j;
+        break;
+    }
+    if (!cpy) {
+        return 0;
+    }
+    const ggml_tensor * src = cpy->src[0];
+    const ggml_tensor * dst = cpy->src[1];
+    if (src->op != GGML_OP_VIEW || src->view_src != ssm || src->view_offs != tail_off ||
+        src->type != GGML_TYPE_F32 || !ggml_is_contiguous(src) || ggml_nelements(src) != D ||
+        (src->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    const std::array<int64_t, GGML_MAX_DIMS> expected_ne = { D, 1, 1, 1 };
+    if (dst->op != GGML_OP_VIEW || dst->type != GGML_TYPE_F32 || !dst->data ||
+        !dst->buffer || !ssm->buffer || dst->buffer->buft != ssm->buffer->buft ||
+        (uintptr_t) dst->data % sizeof(float) != 0 ||
+        !std::equal(expected_ne.begin(), expected_ne.end(), dst->ne) ||
+        dst->nb[0] != sizeof(float) || dst->nb[1] != state_bytes || cpy->data != dst->data) {
+        return 0;
+    }
+
+    // Reuse graph use counts for the removed tail and for direct consumers of the scan.
+    // Other views must lie wholly in y; sibling/nested tail views remain live.
+    int view_uses = 0;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->src[0] == ssm && ggml_is_view_op(n->op)) {
+            ++view_uses;
+        }
+        if (n == src) {
+            if (ggml_node_get_use_count(cgraph, j) != 1) {
+                return 0;
+            }
+            continue;
+        }
+        if (n->view_src == ssm && (n->view_offs > tail_off || ggml_nbytes(n) > tail_off - n->view_offs)) {
+            return 0;
+        }
+    }
+    if (view_uses != ggml_node_get_use_count(cgraph, node_idx)) {
+        return 0; // a non-view consumer would read the unmaterialised tail
+    }
+
+    // The same conservative byte-range dependency check used by sibling kernel fusion.
+    // Integer differences avoid ordering unrelated host pointers or overflowing an end address.
+    auto overlaps = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const uintptr_t ap = (uintptr_t) a->data;
+        const uintptr_t bp = (uintptr_t) b->data;
+        return ap <= bp ? bp - ap < ggml_nbytes(a) : ap - bp < ggml_nbytes(b);
+    };
+    if (!ssm->data || overlaps(dst, ssm)) {
+        return 0;
+    }
+    for (int k = 0; k < 7; ++k) {
+        if (ssm->src[k]->type != (k == 6 ? GGML_TYPE_I32 : GGML_TYPE_F32) || !ssm->src[k]->data ||
+            overlaps(ssm, ssm->src[k]) || (k != 0 && overlaps(dst, ssm->src[k]))) {
+            return 0;
+        }
+    }
+    if (overlaps(dst, s)) {
+        const uintptr_t sp = (uintptr_t) s->data;
+        const uintptr_t dp = (uintptr_t) dst->data;
+        // A single sequence can overwrite one complete, aligned input-state row: each
+        // warp reads its own state before writing that same coordinate. A shifted or
+        // partial overlap could clobber a different warp's input, so it must fall back.
+        if (dp < sp || dp - sp > ggml_nbytes(s) - state_bytes || (dp - sp) % state_bytes != 0) {
+            return 0;
+        }
+    }
+
+    cache = (float *) dst->data;
+    return cpy_idx - node_idx;
+}
