  dpct::queue_ptr main_stream = ctx.stream();\n    SYCL_CHECK(ggml_sycl_set_device(ctx.device));\n    const float * src0_dd = static_cast<const float *>(dst->src[0]->data);\n    float *       dst_dd  = static_cast<float *>(dst->data);\n\n    const int64_t ncols = dst->src[0]->ne[0];\n    const int64_t nrows = ggml_nrows(dst->src[0]);\n\n    sum_rows_f32_sycl(src0_dd, dst_dd, ncols, nrows, main_stream);\n}\n\ninline void ggml_sycl_op_mean(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {\n    GGML_ASSERT(dst->src[0]->type == GGML_TYPE_F32);\n    GGML_ASSERT(dst->type == GGML_TYPE_F32);\n\n    dpct::queue_ptr main_stream = ctx.stream();\n    SYCL_CHECK(ggml_sycl_set_device(ctx.device));\n\n    const float * src0_dd = static_cast<const float *>(dst->src[0]->data);\n    float *       dst_dd  = static_cast<float *>(dst->data);\n\n    const int64_t ncols = dst->src[0]->ne[0];\n    const int64_t nrows = ggml_nrows(dst->src[0]);\n\n    sum_rows_f32_sycl(src0_dd, dst_dd, ncols, nrows, main_stream);\n\n    main_stream->parallel_for(\n        sycl::range<1>(nrows),\n        [=](sycl::id<1> row) {\n            dst_dd[row] /= ncols;\n        }\n    );\n}\n\n\ninline void ggml_sycl_op_argsort(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {\n    GGML_ASSERT(dst->src[0]->type == GGML_TYPE_F32);\n    GGML_ASSERT(dst->type == GGML_TYPE_I32);\n    dpct::queue_ptr main_stream = ctx.stream();\n    SYCL_CHECK(ggml_sycl_set_device(ctx.device));\n    const float * src0_dd = static_cast<const float *>(dst->src[0]->data);\n    int32_t *       dst_dd  = static_cast<int32_t *>(dst->data);\n\n\n    const int64_t ncols = dst->src[0]->ne[0];\n    const int64_t nrows = ggml_nrows(dst->src[0]);\n\n    enum ggml_sort_order order = (enum ggml_sort_order) dst->op_params[0];\n\n    argsort_f32_i32_sycl(src0_dd, (int *)dst_dd, ncols, nrows, order,\n                         main_stream, ctx.device, ctx.pool());\n}\n\n// Bolt routing only: keep the original shared-memory bitonic network (including\n// its strict tie comparisons and padding). There is no global-sort fusion.\nstatic int ggml_sycl_router_fused(ggml_backend_sycl_context & ctx, ggml_cgraph * graph, int i) {\n    if (!g_ggml_sycl_enable_fusion || i + 2 >= graph->n_nodes) {\n        return 0;\n    }\n    ggml_tensor * probs = graph->nodes[i];\n    int add_idx = i + 1;\n    // build_moe_ffn visits the raw-probability weight view before the selection\n    // branch. Admit only that exact metadata reshape, never an executable node.\n    const ggml_tensor * view = graph->nodes[add_idx];\n    if (view->op == GGML_OP_RESHAPE && view->src[0] == probs &&\n        view->ne[0] == 1 && view->ne[1] == probs->ne[0] &&\n        view->ne[2] == probs->ne[1] && view->ne[3] == 1) {\n        ++add_idx;\n    }\n    if (add_idx + 1 >= graph->n_nodes) {\n        return 0;\n    }\n    ggml_tensor * biased = graph->nodes[add_idx];\n    ggml_tensor * indices = graph->nodes[add_idx + 1];\n    const int nodes[] = { i, add_idx, add_idx + 1 };\n    const ggml_op ops[] = { GGML_OP_UNARY, GGML_OP_ADD, GGML_OP_ARGSORT };\n    // All three values are materialized, including externally consumed raw\n    // probabilities. Output exceptions still require COMPUTE on every node.\n    if (!ggml_can_fuse_subgraph_ext(graph, nodes, 3, ops, nodes, 3) ||\n        ggml_get_unary_op(probs) != GGML_UNARY_OP_SIGMOID ||\n        biased->src[0] != probs || indices->src[0] != biased ||\n        indices->op_params[0] != GGML_SORT_ORDER_DESC) {\n        return false;\n    }\n    const ggml_tensor * logits = probs->src[0];\n    const ggml_tensor * bias = biased->src[1];\n    const int64_t nc = probs->ne[0];\n    if (!logits || !bias || (nc != 240 && nc != 304 && nc != 368 && nc != 432 && nc != 496) ||\n        probs->ne[1] < 1 || probs->ne[1] > 1024 || probs->ne[2] != 1 || probs->ne[3] != 1) {\n        return false;\n    }\n    for (const ggml_tensor * t : std::array<const ggml_tensor *, 5>{ logits, bias, probs, biased, indices }) {\n        if (!t->data || !t->buffer ||\n            ggml_backend_buffer_get_type(t->buffer) != ggml_backend_sycl_buffer_type(ctx.device) ||\n            t->type != (t == indices ? GGML_TYPE_I32 : GGML_TYPE_F32) || !ggml_is_contiguous(t)) {\n            return false;\n        }\n        if (t == bias ? (t->ne[0] != nc || t->ne[1] != 1 || t->ne[2] != 1 || t->ne[3] != 1) :\n                        !ggml_are_same_shape(t, probs)) {\n            return false;\n        }\n    }\n    const auto overlaps = [](const ggml_tensor * a, const ggml_tensor * b) {\n        const uintptr_t x = (uintptr_t) a->data, y = (uintptr_t) b->data;\n        return x <= y ? y - x < ggml_nbytes(a) : x - y < ggml_nbytes(b);\n    };\n    const auto same_range = [](const ggml_tensor * a, const ggml_tensor * b) {\n        return a->data == b->data && ggml_nbytes(a) == ggml_nbytes(b);\n    };\n    // A lane loads its logit before either store. Exact packed coordinate reuse\n    // is safe; shifted/cross-row reuse is not. The repeated bias is read-only.\n    for (const ggml_tensor * out : { probs, biased, indices }) {\n        if (overlaps(out, bias) || (overlaps(out, logits) && !same_range(out, logits))) {\n            return false;\n        }\n    }\n    if (overlaps(probs, biased) || overlaps(probs, indices) || overlaps(biased, indices)) {\n        // In particular, do not overwrite biased storage inside the unchanged\n        // sorter: its final barrier fences local, not global, memory.\n        return false;\n    }\n    if (overlaps(indices, logits)) {\n        // Indices may reuse a dead, non-view computed logit allocation, after\n        // the global barrier. Never erase an externally visible logit or view.\n        if (logits->op == GGML_OP_NONE || logits->view_src ||\n            (logits->flags & (GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT))) {\n            return false;\n        }\n        const auto live_logit = [&](const ggml_tensor * t) {\n            if (t != probs) {\n                for (con