+static bool ggml_sycl_out_prod_f32_matrix_supported(const ggml_tensor * tensor) {
+    constexpr size_t element_size = sizeof(float);
+
+    return tensor->nb[0] == element_size &&
+           tensor->nb[1] % element_size == 0 &&
+           tensor->nb[1] / element_size >= (size_t) tensor->ne[0] &&
+           tensor->nb[2] % element_size == 0 &&
+           tensor->nb[3] % element_size == 0;
+}
+
+static bool ggml_sycl_out_prod_src1_supported(const ggml_tensor * src1) {
+    constexpr size_t element_size = sizeof(float);
+    const bool src1_T = ggml_is_transposed(src1);
+    const size_t inner_stride = src1_T ? src1->nb[1] : src1->nb[0];
+    const size_t leading_stride = src1_T ? src1->nb[0] : src1->nb[1];
+    const int64_t leading_dim = src1_T ? src1->ne[1] : src1->ne[0];
+
+    return leading_dim > 0 &&
+           inner_stride == element_size &&
+           leading_stride % element_size == 0 &&
+           leading_stride / element_size >= (size_t) leading_dim &&
+           src1->nb[2] % element_size == 0 &&
+           src1->nb[3] % element_size == 0;
+}
+
+bool ggml_sycl_supports_out_prod(const ggml_tensor * dst) {
+    if (dst == nullptr || dst->src[0] == nullptr || dst->src[1] == nullptr) {
+        return false;
+    }
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    if (dst->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 ||
+        (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_Q1_0)) {
+        return false;
+    }
+
+    if (src0->ne[2] <= 0 || src0->ne[3] <= 0 ||
+        dst->ne[0] != src0->ne[0] || dst->ne[1] != src1->ne[0] ||
+        src0->ne[1] != src1->ne[1] || dst->ne[2] != src1->ne[2] ||
+        dst->ne[3] != src1->ne[3] || dst->ne[2] % src0->ne[2] != 0 ||
+        dst->ne[3] % src0->ne[3] != 0) {
+        return false;
+    }
+
+    if (src0->type == GGML_TYPE_Q1_0) {
+        if (!ggml_is_contiguous(src0) || src0->ne[2] != src1->ne[2] ||
+            src0->ne[3] != src1->ne[3]) {
+            return false;
+        }
+    } else if (!ggml_sycl_out_prod_f32_matrix_supported(src0)) {
+        return false;
+    }
+
+    return ggml_is_contiguous(dst) && ggml_sycl_out_prod_src1_supported(src1);
+}
