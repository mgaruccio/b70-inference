+// LILICORR_PROFILE_ONLY_BEGIN
+// Private development hook. Scheduler split submissions call backend graph_compute
+// synchronously on this host thread; GPU completion may remain asynchronous.
+static thread_local unsigned lilicorr_context_profile_depth = 0;
+
+struct lilicorr_context_profile_scope {
+    using setter = bool (*)(bool) noexcept;
+    struct saved_state { setter set; bool previous; };
+    std::vector<saved_state> states;
+    bool active = false;
+
+    lilicorr_context_profile_scope(const std::vector<ggml_backend_ptr> & backends, bool is_lilicorr) {
+        const char * value = is_lilicorr ? std::getenv("LLAMA_LILICORR_PROFILE") : nullptr;
+        const bool enabled = value && std::strcmp(value, "1") == 0;
+        if (!enabled && lilicorr_context_profile_depth == 0) {
+            return; // No lookup, allocation, clock, or state change on the ordinary path.
+        }
+        // A nested non-drafter submission temporarily suspends an outer scope.
+        // Allocate and resolve ALL callbacks before setting ANY backend TLS flags.
+        states.reserve(backends.size());
+        for (const auto & backend : backends) {
+            auto * device = ggml_backend_get_device(backend.get());
+            auto * reg = device ? ggml_backend_dev_backend_reg(device) : nullptr;
+            auto set = reg ? reinterpret_cast<setter>(ggml_backend_reg_get_proc_address(
+                    reg, "set_lilicorr_profile_scope")) : nullptr;
+            if (set) {
+                states.push_back({set, false});
+            }
+        }
+        for (auto & state : states) {
+            state.previous = state.set(enabled); // Private setters are noexcept.
+        }
+        ++lilicorr_context_profile_depth;
+        active = true;
+    }
+
+    void restore() noexcept {
+        if (active) {
+            for (auto it = states.rbegin(); it != states.rend(); ++it) {
+                it->set(it->previous);
+            }
+            --lilicorr_context_profile_depth;
+            active = false;
+        }
+    }
+
+    ~lilicorr_context_profile_scope() { restore(); }
+    lilicorr_context_profile_scope(const lilicorr_context_profile_scope &) = delete;
+    lilicorr_context_profile_scope & operator=(const lilicorr_context_profile_scope &) = delete;
+};
+
