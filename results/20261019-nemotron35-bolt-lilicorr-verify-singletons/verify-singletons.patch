+// Exact target-layer names also exclude the appended MTP layer (il == n_layer).
+// The DFlash architecture is rejected separately at each producer below.
+static bool nemotron_verify_weight(const ggml_tensor * w, int64_t n_layer, const char * suffix) {
+    const char * p = w->name;
+    if (std::strncmp(p, "blk.", 4) != 0 || n_layer <= 0) return false;
+    p += 4;
+    if (*p < '0' || *p > '9') return false;
+    int64_t layer = 0;
+    while (*p >= '0' && *p <= '9') {
+        const int digit = *p++ - '0';
+        if (digit >= n_layer || layer > (n_layer - 1 - digit) / 10) return false;
+        layer = 10 * layer + digit;
+    }
+    return std::strcmp(p, suffix) == 0;
+}
