+struct test_mul_mat_verify_singletons : public test_mul_mat {
+    const int profile;
+    const bool marked;
+    const int layout; // 0 plain; 1 offset; 2 padded columns; 3 full attention reshape
+    const int annotation; // 0 absent (GLM-like F32); 1 private target marker; 2 malformed
+    ggml_tensor * wide = nullptr;
+    ggml_tensor * single = nullptr;
+    static const char * weight(int p) {
+        const char * names[] = {"blk.1.ffn_latent_down.weight", "blk.1.ffn_latent_up.weight",
+            "blk.7.attn_q.weight", "blk.7.attn_k.weight", "blk.7.attn_v.weight", "blk.7.attn_output.weight"};
+        return names[p];
+    }
+    test_mul_mat_verify_singletons(int p, int64_t n, bool marked, int layout = 0, int annotation = 1) :
+        test_mul_mat(GGML_TYPE_Q8_0, GGML_TYPE_F32, p == 0 ? 1024 : (p == 3 || p == 4 ? 256 : 4096),
+                     n, p == 1 ? 1024 : 4096, {1, 1}, {1, 1}), profile(p), marked(marked), layout(layout), annotation(annotation) {}
+    std::string id() const {
+        return "q8-p" + std::to_string(profile) + "-n" + std::to_string(n) +
+               "-m" + std::to_string(marked) + "-l" + std::to_string(layout) +
+               (annotation == 1 ? "" : "-a" + std::to_string(annotation));
+    }
+    std::string vars() override { return "verify_singletons=1,case=" + id(); }
+    std::string op_desc(ggml_tensor *) override { return "MUL_MAT"; }
+    bool run_whole_graph() override { return true; }
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, k, m);
+        ggml_set_name(a, weight(profile));
+        ggml_tensor * b;
+        if (layout == 3) {
+            GGML_ASSERT(profile == 5);
+            b = ggml_reshape_2d(ctx, ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 128, 32, n), k, n);
+        } else {
+            const int64_t stride = k + (layout == 2 ? 16 : 0);
+            b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, stride, n + (layout == 1));
+            if (layout) b = ggml_view_2d(ctx, b, k, n, b->nb[1], layout == 1 ? b->nb[1] : 0);
+        }
+        wide = ggml_mul_mat(ctx, a, b);
+        if (marked) {
+            GGML_ASSERT(ggml_prec_set_acc(wide, GGML_PREC_F32));
+            wide->op_params[15] = annotation == 0 ? 0 : (0x4e535631 ^ (annotation == 2));
+        }
+        ggml_format_name(wide, "%s-wide", id().c_str());
+        single = nullptr;
+        for (int64_t col = 0; col < n; ++col) {
+            ggml_tensor * input = ggml_cont(ctx, ggml_view_2d(ctx, b, k, 1, b->nb[1], col * b->nb[1]));
+            ggml_tensor * out = ggml_mul_mat(ctx, a, input); // baseline default-precision n=1
+            ggml_format_name(out, "%s-s%lld", id().c_str(), (long long) col);
+            single = single ? ggml_concat(ctx, single, out, 1) : out;
+        }
+        ggml_set_output(wide);
+        ggml_set_output(single);
+        return ggml_concat(ctx, wide, single, 1);
+    }
+    double err(const float * a, const float * b, size_t count) override {
+        if (count == 2 * (size_t) ggml_nelements(wide)) {
+            const bool required = (layout == 0 || layout == 3) && (n <= 2 || (marked && annotation == 1 && n <= 8));
+            if (!verify_singletons_bytes(id(), wide, single, required)) return INFINITY;
+        }
+        return test_mul_mat::err(a, b, count);
+    }
+};
