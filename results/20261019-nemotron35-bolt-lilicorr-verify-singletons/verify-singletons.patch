+// Same-device byte comparison of real wide operations against concatenated n=1
+// operations on the SAME inputs. CPU-reference NMSE remains inherited (5e-4).
+static bool verify_singletons_bytes(const std::string & id, ggml_tensor * wide, ggml_tensor * single, bool required) {
+    const size_t bytes = ggml_nbytes(wide);
+    GGML_ASSERT(bytes == ggml_nbytes(single));
+    std::vector<uint8_t> a(bytes), b(bytes);
+    ggml_backend_tensor_get(wide, a.data(), 0, bytes);
+    ggml_backend_tensor_get(single, b.data(), 0, bytes);
+    size_t mismatches = 0;
+    for (size_t i = 0; i < bytes; ++i) mismatches += a[i] != b[i];
+    printf("\nBOLT_SINGLETON case=%s bytes=%zu required=%d mismatches=%zu\n", id.c_str(), bytes, int(required), mismatches);
+    return !required || mismatches == 0;
+}
