+// fallbacks on the SAME allocation. Ordinary test_mul_mat names its weights "a",
+// which deliberately does not opt into this experimental Mamba-only path.
+struct test_mul_mat_nvfp4_reorder : public test_mul_mat {
+    const bool f32;
+    const bool eligible;
+    std::vector<ggml_tensor *> checked;
+
+    test_mul_mat_nvfp4_reorder(int64_t m, int64_t n, int64_t k, bool f32, bool eligible = true) :
+        test_mul_mat(GGML_TYPE_NVFP4, GGML_TYPE_F32, m, n, k, {1, 1}, {1, 1}), f32(f32), eligible(eligible) {}
+
+    std::string vars() override {
+        return "nvfp4_reorder=1," + test_mul_mat::vars() + "," + VARS_TO_STR2(f32, eligible);
+    }
+
+    bool run_whole_graph() override { return true; }
+    std::vector<ggml_tensor *> fusion_test_nodes() override { return checked; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_NVFP4, k, m);
+        ggml_set_name(a, !eligible ? "blk.0.attn_q.weight" :
+                         k == 8192 ? "blk.0.ssm_out.weight" : "blk.0.ssm_in.weight");
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_tensor * v = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, 1);
+        ggml_tensor * before = ggml_mul_mat(ctx, a, b);
+        // A zero-valued data dependency enforces prefill -> decode -> later call.
+        ggml_tensor * v_ready = ggml_add(ctx, v, ggml_scale(ctx, ggml_sum(ctx, before), 0.0f));
+        ggml_tensor * decode = ggml_mul_mat(ctx, a, v_ready);
+        ggml_tensor * b_ready = ggml_add(ctx, b, ggml_scale(ctx, ggml_sum(ctx, decode), 0.0f));
+        ggml_tensor * after = ggml_mul_mat(ctx, a, b_ready);
+        checked = {before, decode, after};
+        for (ggml_tensor * t : checked) {
+            GGML_ASSERT(ggml_prec_set_acc(t, f32 ? GGML_PREC_F32 : GGML_PREC_DEFAULT));
+        }
+        return after;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type != GGML_TYPE_NVFP4) {
+                init_tensor_uniform(t);
+                continue;
+            }
+            // Raw blocks cover all 128 UE4M3 codes (including zero, subnormals,
+            // maximum exponent and the 0x7f sentinel) and all E2M1 nibbles.
+            constexpr size_t block_size = 36;
+            GGML_ASSERT(ggml_blck_size(t->type) == 64 && ggml_type_size(t->type) == block_size);
+            std::vector<uint8_t> data(ggml_nbytes(t));
+            for (size_t ib = 0; ib < data.size() / block_size; ++ib) {
+                uint8_t * block = data.data() + ib * block_size;
+                for (int s = 0; s < 4; ++s) {
+                    block[s] = (ib + 29 * s) & 127;
+                }
+                for (int j = 0; j < 32; ++j) {
+                    block[4 + j] = (17 * ib + 29 * j) & 255;
+                }
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
+        }
+    }
+};
