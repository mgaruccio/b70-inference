+// Experimental dense NVFP4 layout: [all 32-byte qs blocks][all four-byte d blocks].
+// Keep the four UE4M3 subblock scales intact; this is not MXFP4's E8M0 layout.
+static bool reorder_qw_nvfp4(uint8_t * data_device, size_t size, dpct::queue_ptr stream) {
+    GGML_ASSERT(size % sizeof(block_nvfp4) == 0);
+    const size_t nblocks = size / sizeof(block_nvfp4);
+    sycl_reorder_temp_buffer tmp(stream, size);
+    if (!tmp) {
+        GGML_LOG_WARN("%s: failed to allocate %zu bytes, skipping reorder\n", __func__, size);
+        return false;
+    }
+    auto * tmp_buf = static_cast<uint8_t *>(tmp.ptr);
+    sycl::event copy_event;
+    SYCL_CHECK(CHECK_TRY_ERROR(copy_event = stream->memcpy(tmp_buf, data_device, size)));
+    if (!g_ggml_sycl_use_async_mem_op) {
+        copy_event.wait();
+    }
+    auto * qs = data_device;
+    auto * d  = qs + nblocks * (QK_NVFP4 / 2);
+    auto reorder_event = stream->parallel_for(nblocks, [=](auto i) {
+        const block_nvfp4 * x = reinterpret_cast<const block_nvfp4 *>(tmp_buf);
+        const size_t ib = i;
+        for (int j = 0; j < QK_NVFP4 / 2; ++j) {
+            qs[ib * (QK_NVFP4 / 2) + j] = x[ib].qs[j];
+        }
+        for (int j = 0; j < QK_NVFP4 / QK_NVFP4_SUB; ++j) {
+            d[ib * (QK_NVFP4 / QK_NVFP4_SUB) + j] = x[ib].d[j];
