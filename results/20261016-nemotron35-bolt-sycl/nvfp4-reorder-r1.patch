+template <> struct reorder_vec_dot_q_sycl<GGML_TYPE_NVFP4> {
+    static constexpr ggml_type gtype = GGML_TYPE_NVFP4;
+
+    __dpct_inline__ float operator()(const void * __restrict__ vbq, const std::pair<int, int> ibx_offset,
+                                     const std::pair<int, int> d_offset, const int8_t * q8_1_quant_ptr,
+                                     const sycl::half2 * q8_1_ds, const int iqs) {
+        // Two lanes per 64-value block, iqs = 0 or 4. Each lane covers two
+        // independently scaled 16-value subblocks, not one MXFP4 block.
+        const uint8_t * base = static_cast<const uint8_t *>(vbq);
+        const sycl::int4 q4 = *reinterpret_cast<const sycl::int4 *>(base + ibx_offset.first + sizeof(int) * iqs);
+        const uint8_t * scales = base + d_offset.first;
+        float sum = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            const int sub = iqs / 2 + i;
+            const sycl::int2 v0 = get_int_from_mxfp4(q4[2 * i]);
+            const sycl::int2 v1 = get_int_from_mxfp4(q4[2 * i + 1]);
+            const sycl::int4 u = *reinterpret_cast<const sycl::int4 *>(q8_1_quant_ptr + sub * QK_NVFP4_SUB);
+            int sumi = ggml_sycl_dp4a(v0.x(), u.x(), 0);
+            sumi     = ggml_sycl_dp4a(v0.y(), u.z(), sumi);
+            sumi     = ggml_sycl_dp4a(v1.x(), u.y(), sumi);
+            sumi     = ggml_sycl_dp4a(v1.y(), u.w(), sumi);
+            // ue4m3_to_fp32 already includes the 0.5 factor for the integer E2M1 table.
+            const float d = ggml_sycl_ue4m3_to_fp32(scales[sub]) * static_cast<float>(q8_1_ds[sub / 2][0]);
+            sum += d * float(sumi);
+        }
+        return sum;
+    }
+};
