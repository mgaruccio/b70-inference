+template <typename dst_t>
+static void dequantize_row_nvfp4_sycl_packed(const void * vx, dst_t * y, const int64_t k, dpct::queue_ptr stream) {
+    const int64_t nb = k / QK_NVFP4;
+    const size_t work_groups = static_cast<size_t>((nb + 7) / 8);
+    stream->parallel_for(
