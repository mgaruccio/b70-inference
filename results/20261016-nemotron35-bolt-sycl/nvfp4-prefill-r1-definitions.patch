+    GGML_ASSERT(k % QK_NVFP4 == 0);
+    const int64_t nb = k / QK_NVFP4;
+    const bool use_packed =
+        !reordered && std::is_same_v<dst_t, float> && g_ggml_sycl_enable_fusion && nb >= 8 &&
+        stream->get_device().get_info<sycl::info::device::max_work_group_size>() >= 256;
+
+    GGML_SYCL_DEBUG("[SYCL][NVFP4] path=%s k=%lld blocks=%lld\n",
+                    use_packed ? "packed" : "original",
+                    static_cast<long long>(k), static_cast<long long>(nb));
+    if (use_packed) {
+        dequantize_row_nvfp4_sycl_packed<dst_t>(vx, y, k, stream);
+    } else {
+        dequantize_row_nvfp4_sycl_original<dst_t, reordered>(vx, y, k, stream);
+    }
 }
 
 
