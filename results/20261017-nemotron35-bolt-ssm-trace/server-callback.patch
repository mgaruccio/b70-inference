+static bool bolt_tensor_trace_enabled() {
+    const char * env = std::getenv("BOLT_TRACE_TENSORS");
+    return env != nullptr && std::strcmp(env, "1") == 0;
+}
+
+static bool bolt_tensor_trace_wants_tensor(const ggml_tensor * t) {
+    const char * name = t->name;
+    const char * selected[] = {
+        "embd", "norm-0", "attn_norm-0", "mamba2_y_add_d-0",
+        "mamba_out-0", "nemotron_h_block_out-0", "result_output",
+    };
+    for (const char * candidate : selected) {
+        if (std::strcmp(name, candidate) == 0) {
+            return true;
+        }
+    }
+    const ggml_tensor * weight = nullptr;
+    switch (t->op) {
+        case GGML_OP_MUL_MAT:  weight = t->src[0]; break;
+        case GGML_OP_SSM_CONV: weight = t->src[1]; break;
+        case GGML_OP_SSM_SCAN: weight = t->src[3]; break;
+        default: break;
+    }
+    return weight != nullptr && std::strncmp(weight->name, "blk.0.", 6) == 0;
+}
+
+static bool bolt_tensor_trace_cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+    if (ask) {
+        return bolt_tensor_trace_wants_tensor(t);
+    }
+    if (!bolt_tensor_trace_wants_tensor(t)) {
+        return true;
+    }
+    return common_debug_cb_eval(t, false, user_data);
+}
