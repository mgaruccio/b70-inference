+// Fused F32 RELU -> SQR.  This intentionally reads the original RELU input and
+// writes the SQR result, so the graph scheduler can elide the intermediate launch.
+static void relu_sqr_kernel(const float * x, float * dst, const int64_t k,
+                            const sycl::nd_item<1> & item_ct1) {
+    SYCL_GLOBAL_ID_LOOP(k, item_ct1) {
+        dst[i] = op_sqr(op_relu(x[i]));
+    }
+}
+
+static void relu_sqr_sycl(const float * x, float * dst, const int64_t k, queue_ptr stream) {
+    const size_t num_blocks = ceil_div((size_t) k, (size_t) SYCL_GLU_BLOCK_SIZE);
+    const sycl::nd_range<1> range(num_blocks * sycl::range<1>(SYCL_GLU_BLOCK_SIZE),
+                                  sycl::range<1>(SYCL_GLU_BLOCK_SIZE));
+    stream->parallel_for(range, [=](sycl::nd_item<1> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+        relu_sqr_kernel(x, dst, k, item_ct1);
     });
