+// Exercise the actual NVFP4 -> BF16 and F32 -> BF16 converters through MUL_MAT,
+// not a CPY implementation or a host-only emulation of the new dispatch.
+struct test_mul_mat_nvfp4_bf16_reference : public test_mul_mat_nvfp4_reorder {
+    const bool rne;
+    const bool reordered;
+    ggml_tensor * weights = nullptr;
+    ggml_tensor * input = nullptr;
+    std::vector<float> reference;
+
+    test_mul_mat_nvfp4_bf16_reference(bool rne, bool reordered) :
+        test_mul_mat_nvfp4_reorder(37, 9, 192, false), rne(rne), reordered(reordered) {}
+
+    std::string vars() override {
+        return "nvfp4_bf16_reference=1," + test_mul_mat::vars() + "," + VARS_TO_STR2(rne, reordered);
+    }
+
+    double max_nmse_err() override { return rne ? 0.0 : 5e-4; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        weights = ggml_new_tensor_2d(ctx, GGML_TYPE_NVFP4, k, m);
+        ggml_set_name(weights, "blk.0.ssm_in.weight");
+        input = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_tensor * ready = input;
+        if (reordered) {
+            ggml_tensor * v = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, 1);
+            ggml_tensor * decode = ggml_mul_mat(ctx, weights, v);
+            GGML_ASSERT(ggml_prec_set_acc(decode, GGML_PREC_BF16));
+            ready = ggml_add(ctx, input, ggml_scale(ctx, ggml_sum(ctx, decode), 0.0f));
+        }
+        ggml_tensor * out = ggml_mul_mat(ctx, weights, ready);
+        GGML_ASSERT(ggml_prec_set_acc(out, GGML_PREC_BF16));
+        checked = {out};
+        return out;
+    }
+
+    static float from_bits(uint32_t bits) {
+        float value;
+        memcpy(&value, &bits, sizeof(value));
+        return value;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_mul_mat_nvfp4_reorder::initialize_tensors(ctx);
+        // Positive/negative halfway-even/odd, just below/above a tie, exponent carry.
+        static const uint32_t bits[] = {
+            0x3f808000, 0x3f818000, 0x3f807fff, 0x3f808001, 0x3fff8000,
+            0xbf808000, 0xbf818000, 0xbf807fff, 0xbf808001, 0xbfff8000,
+        };
+        static const uint32_t rounded[] = {
+            0x3f800000, 0x3f820000, 0x3f800000, 0x3f810000, 0x40000000,
+            0xbf800000, 0xbf820000, 0xbf800000, 0xbf810000, 0xc0000000,
+        };
+        std::vector<float> values(k*n);
+        for (size_t i = 0; i < values.size(); ++i) {
+            values[i] = from_bits(bits[i % 10]);
+        }
+        ggml_backend_tensor_set(input, values.data(), 0, ggml_nbytes(input));
+        reference.assign(m*n, 0.0f);
+        if (rne) {
+            // Each row selects a different input: the product by exactly 1 makes
+            // the observable result the actual activation converter's BF16 bits.
+            std::vector<uint8_t> data(ggml_nbytes(weights), 0);
+            for (size_t ib = 0; ib < data.size() / 36; ++ib) {
+                std::fill_n(data.data() + ib*36, 4, uint8_t(0x38)); // UE4M3 scale 1
+            }
+            for (int64_t row = 0; row < m; ++row) {
+                const int64_t j = row % 64;
+                const size_t block = row*(k/64) + row/64;
+                // NVFP4 packs the low/high halves of each 16-value subblock.
+                data[block*36 + 4 + (j/16)*8 + j%8] = uint8_t(2 << ((j%16 >= 8) ? 4 : 0));
+                for (int64_t col = 0; col < n; ++col) {
+                    reference[col*m + row] = from_bits(rounded[(col*k + row) % 10]);
+                }
+            }
+            ggml_backend_tensor_set(weights, data.data(), 0, ggml_nbytes(weights));
+        } else {
+            // Independent host reference: dequantize original NVFP4, round BOTH
+            // operands to BF16, then accumulate in F32 (no CPU quantized dot).
+            std::vector<float> a = tensor_to_float(weights);
+            for (float & x : a) {
+                x = ggml_bf16_to_fp32(ggml_fp32_to_bf16(x));
+            }
+            for (float & x : values) {
+                x = ggml_bf16_to_fp32(ggml_fp32_to_bf16(x));
+            }
+            for (int64_t col = 0; col < n; ++col) {
+                for (int64_t row = 0; row < m; ++row) {
+                    float sum = 0.0f;
+                    for (int64_t p = 0; p < k; ++p) {
+                        sum = std::fma(a[row*k + p], values[col*k + p], sum);
+                    }
+                    reference[col*m + row] = sum;
+                }
+            }
+        }
+    }
+
+    double err(const float * a, const float * b, size_t size) override {
+        GGML_ASSERT(size == reference.size());
+        if (rne) {
+            // The ordinary CPU NVFP4 dot need not round activations to BF16.
+            // Compare GPU output to fixed expected bits, not to that CPU output.
+            return memcmp(a, reference.data(), size*sizeof(float)) == 0 ? 0.0 : 1.0;
+        }
+        return std::max(nmse(a, b, size), nmse(a, reference.data(), size));
+    }
+};
