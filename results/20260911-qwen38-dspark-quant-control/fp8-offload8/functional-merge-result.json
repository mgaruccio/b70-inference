  "content": "def merge_intervals(items):\n    if not items:\n        return []\n    sorted_items = sorted(items, key=lambda x: (x[0], x[1]))\n    merged = [list(sorted_items[0])]\n    for start, end in sorted_items[1:]:\n        last = merged[-1]\n        if start <= last[1]:\n            last[1] = max(last[1], end)\n        else:\n            merged.append([start, end])\n    return merged",
