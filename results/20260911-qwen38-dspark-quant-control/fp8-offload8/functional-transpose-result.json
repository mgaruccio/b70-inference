  "content": "def transpose(rows):\n    if not rows:\n        return []\n    if not all(isinstance(row, list) for row in rows):\n        raise ValueError(\"All rows must be lists\")\n    width = len(rows[0])\n    for row in rows:\n        if len(row) != width:\n            raise ValueError(\"Ragged input: all rows must have the same length\")\n    return [[row[i] for row in rows] for i in range(width)]",
