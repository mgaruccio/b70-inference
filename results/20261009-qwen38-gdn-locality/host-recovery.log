set -eu
printf 'TEMPORARY_KERNEL_BOOST_GUARD '; date --iso-8601=seconds
printf 'BOOT_ID='; cat /proc/sys/kernel/random/boot_id
timeout --kill-after=1s 15s sudo -n python3 - <<'PY'
from pathlib import Path
import subprocess

def read(path):
    return subprocess.run(['cat', str(path)], check=True, capture_output=True,
                          text=True, timeout=3).stdout.strip()

assert read('/proc/sys/kernel/random/boot_id') == 'c93aea98-bb22-4cf6-879f-42d2980cb726', 'Unexpected boot; no write'
policy = Path('/sys/devices/system/cpu/cpufreq/policy0')
assert read(policy/'scaling_driver') == 'amd-pstate-epp', 'Unexpected driver; no write'
p = Path('/sys/devices/system/cpu/cpufreq/boost')
assert p.is_file(), 'System-wide boost interface absent; no write'
before = read(p)
assert before == '1', ('Unexpected initial boost state; no write', before)
max_before = int(read(policy/'cpuinfo_max_freq'))
print('ORIGINAL boost=', before, 'cpuinfo_max_freq_kHz=', max_before, flush=True)
print('Writing only the documented kernel boost control; BIOS variables untouched.', flush=True)
with p.open('w') as f:
    f.write('0\n')
after = read(p)
max_after = int(read(policy/'cpuinfo_max_freq'))
scaling_after = int(read(policy/'scaling_max_freq'))
print('READBACK boost=', after, 'cpuinfo_max_freq_kHz=', max_after,
      'scaling_max_freq_kHz=', scaling_after, flush=True)
assert after == '0', 'Boost disable readback failed'
assert max_after < max_before, 'Cached maximum did not decrease'
assert scaling_after <= max_after, 'Policy maximum exceeds non-boost CPUinfo maximum'
print('KERNEL_GUARD_VERIFIED; current boot only; BIOS CO remains unchanged.', flush=True)
print('Restore original 1 through /sys/devices/system/cpu/cpufreq/boost when appropriate; not restored automatically.', flush=True)
PY
printf 'DONE '; date --iso-8601=seconds


