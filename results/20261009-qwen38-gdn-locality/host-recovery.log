root = Path('/sys/devices/system/cpu/cpufreq')
policies = sorted(root.glob('policy*'), key=lambda p:int(p.name[6:]))
assert policies, 'No CPU policies'
for p in policies:
    r = subprocess.run(['cat', str(p/'scaling_max_freq')], check=True,
                       capture_output=True, text=True, timeout=3)
    maximum = int(r.stdout.strip())
    print(p.name, 'scaling_max_freq_kHz=', maximum, flush=True)
    assert maximum <= 3801000, ('Policy remains above measured non-boost cap', p.name, maximum)
print('ALL_POLICY_CAPS_VERIFIED', len(policies), flush=True)
