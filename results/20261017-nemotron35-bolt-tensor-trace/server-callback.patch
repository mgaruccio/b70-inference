+static bool bolt_tensor_trace_enabled() {
+    const char * env = std::getenv("BOLT_TRACE_TENSORS");
+    return env != nullptr && std::strcmp(env, "1") == 0;
+}
+
+static bool bolt_tensor_trace_wants_tensor(const char * name) {
+    if (name == nullptr) {
+        return false;
+    }
+    if (std::strcmp(name, "inp_embd") == 0) {
+        return true;
+    }
+    if (std::strcmp(name, "result_output") == 0) {
+        return true;
+    }
+    static constexpr char k_l_out_prefix[] = "l_out-";
+    return std::strncmp(name, k_l_out_prefix, sizeof(k_l_out_prefix) - 1) == 0;
+}
+
+static bool bolt_tensor_trace_cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+    if (ask) {
+        return bolt_tensor_trace_wants_tensor(t->name);
+    }
+    if (!bolt_tensor_trace_wants_tensor(t->name)) {
+        return true;
+    }
+    return common_debug_cb_eval(t, false, user_data);
+}
