+// Bounded router control: no queue/pool/reorder/launch during either-column preflight.
+// Call only after exact model dimensions/strides have bounded ggml_nbytes.
+static bool ggml_sycl_router_single2_range(
+    const ggml_backend_sycl_context & ctx, const ggml_tensor * t)
+{
+    if (!t->data || !t->buffer || ggml_backend_buffer_is_sycl_split(t->buffer) ||
+        !ggml_backend_buffer_is_sycl(t->buffer) || !t->buffer->context ||
+        (uintptr_t) t->data % sizeof(float) != 0 ||
+        static_cast<const ggml_backend_sycl_buffer_context *>(t->buffer->context)->device != ctx.device) {
+        return false;
+    }
+    const uintptr_t base = (uintptr_t) ggml_backend_buffer_get_base(t->buffer);
+    const uintptr_t data = (uintptr_t) t->data;
+    const size_t size = ggml_backend_buffer_get_size(t->buffer);
+    return base != 0 && size <= UINTPTR_MAX - base && data >= base && data - base <= size &&
+           ggml_nbytes(t) <= size - (data - base);
+}
+
+static bool ggml_sycl_router_single2_views(
+    const ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+    const ggml_tensor * src1, const ggml_tensor * dst,
+    ggml_tensor (&src1_col)[2], ggml_tensor (&dst_col)[2])
+{
+    if (dst->op != GGML_OP_MUL_MAT || dst->src[0] != src0 || dst->src[1] != src1 ||
+        ggml_get_op_params_i32(dst, 1) != 0 || src0->op != GGML_OP_NONE ||
+        (src0->flags & (GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT | GGML_TENSOR_FLAG_COMPUTE)) ||
+        src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        src0->ne[0] != 4096 || src0->ne[1] != 240 ||
+        src1->ne[0] != 4096 || src1->ne[1] != 2 || dst->ne[0] != 240 || dst->ne[1] != 2) {
+        return false;
+    }
+    constexpr char suffix[] = ".ffn_gate_inp.weight";
+    const size_t len = std::strlen(src0->name);
+    if (len < sizeof(suffix) - 1 || std::strcmp(src0->name + len - (sizeof(suffix) - 1), suffix) != 0) {
+        return false;
+    }
+    for (const ggml_tensor * t : {src0, src1, dst}) {
+        if (t->ne[2] != 1 || t->ne[3] != 1 || t->view_src || t->view_offs ||
+            t->nb[0] != sizeof(float) || t->nb[1] != sizeof(float) * t->ne[0] ||
+            t->nb[2] != t->nb[1] * t->ne[1] || t->nb[3] != t->nb[2] ||
+            !ggml_sycl_router_single2_range(ctx, t)) {
+            return false;
+        }
+        // Only interpret backend-owned extra after verifying the SYCL buffer.
+        const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(t->extra);
+        if (extra && extra->optimized_feature.reorder) return false;
+    }
+    // MUL_MAT must not overwrite either input, even across the two launches.
+    const uintptr_t out = (uintptr_t) dst->data;
+    for (const ggml_tensor * t : {src0, src1}) {
+        const uintptr_t in = (uintptr_t) t->data;
+        if (out < in + ggml_nbytes(t) && in < out + ggml_nbytes(dst)) return false;
+    }
+    for (int col = 0; col < 2; ++col) {
+        src1_col[col] = *src1;
+        dst_col[col] = *dst;
+        src1_col[col].data = (char *) src1->data + col * src1->nb[1];
+        dst_col[col].data = (char *) dst->data + col * dst->nb[1];
+        src1_col[col].ne[1] = 1;
+        dst_col[col].ne[1] = 1;
+        dst_col[col].src[1] = &src1_col[col];
+        // Keep op/precision and original strides; singleton dimensions ignore nb[2/3].
+        if (!ggml_is_contiguous(&src1_col[col]) || !ggml_is_contiguous(&dst_col[col]) ||
+            !ggml_sycl_router_single2_range(ctx, &src1_col[col]) ||
+            !ggml_sycl_router_single2_range(ctx, &dst_col[col])) return false;
+    }
+    return true;
+}
