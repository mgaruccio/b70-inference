+// Six isolated F32 CPU-reference cases for the exact-two-column router control.
+struct test_mul_mat_router_single2 : public test_mul_mat {
+    const char * weight;
+    const int layout; // 0: ordinary; 1: offset view; 2: padded-column view
+
+    test_mul_mat_router_single2(const char * weight, int64_t n, int layout = 0) :
+        test_mul_mat(GGML_TYPE_F32, GGML_TYPE_F32, 240, n, 4096, {1, 1}, {1, 1}),
+        weight(weight), layout(layout) {}
+
+    std::string vars() override {
+        return std::string("router_single2=1,weight=") + weight + ",layout=" + std::to_string(layout) + "," + test_mul_mat::vars();
+    }
+
+    double max_nmse_err() override { return 1e-7; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, m);
+        ggml_set_name(a, weight);
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k + (layout == 2 ? 16 : 0), n + (layout == 1));
+        ggml_set_name(b, "router.input");
+        if (layout != 0) {
+            b = ggml_view_2d(ctx, b, k, n, b->nb[1], layout == 1 ? b->nb[1] : 0);
+            ggml_set_name(b, "router.view");
+        }
+        ggml_tensor * out = ggml_mul_mat(ctx, a, b);
+        ggml_format_name(out, "router_single2-l%d-n%d", layout, (int) n);
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_case::initialize_tensors(ctx);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "router.input") != 0) continue;
+            std::vector<float> data(ggml_nelements(t));
+            for (int64_t col = 0; col < t->ne[1]; ++col) {
+                for (int64_t i = 0; i < t->ne[0]; ++i) {
+                    data[col * t->ne[0] + i] = (col + 1) * ((i % 17) - 8) / 16.0f + (col % 2 ? 0.25f : -0.125f);
+                }
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, data.size() * sizeof(float));
+        }
+    }
+};
