+// LILICORR_SYCL_PROFILE_ONLY_BEGIN
+// Development-only host wall accounting for the actual LiliCorr graph dispatches.  It
+// deliberately records no SYCL events, waits, queue commands, or device durations.
+static int64_t lilicorr_sycl_profile_now_us() {
+    return ggml_time_us();
+}
+
+static bool lilicorr_sycl_profile_requested() {
+    const char * value = std::getenv("LLAMA_LILICORR_PROFILE");
+    return value && std::strcmp(value, "1") == 0;
+}
+
+static bool lilicorr_sycl_profile_marker(const ggml_tensor * tensor) {
+    return tensor && tensor->name[0] && (std::strcmp(tensor->name, "lilicorr_lattice") == 0 || std::strcmp(tensor->name, "inp_noise_embd") == 0 || std::strncmp(tensor->name, "lilicorr.", 9) == 0);
+}
+
+static const ggml_tensor * lilicorr_sycl_profile_graph_marker(const ggml_cgraph * cgraph) {
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (lilicorr_sycl_profile_marker(node)) {
+            return node;
+        }
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            if (lilicorr_sycl_profile_marker(node->src[j])) {
+                return node->src[j];
+            }
+        }
+    }
+    return nullptr;
+}
+
+static const char * lilicorr_sycl_profile_name(const ggml_tensor * tensor) {
+    return tensor && tensor->name[0] ? tensor->name : "-";
+}
+
+static const char * lilicorr_sycl_profile_type(const ggml_tensor * tensor) {
+    return tensor ? ggml_type_name(tensor->type) : "-";
+}
+
+static const char * lilicorr_sycl_profile_op(const ggml_tensor * tensor) {
+    return tensor ? ggml_op_name(tensor->op) : "-";
+}
+
+static std::string lilicorr_sycl_profile_ranges(const std::vector<unsigned char> & covered) {
+    std::string result;
+    for (size_t i = 0; i < covered.size();) {
+        if (!covered[i]) {
+            ++i;
+            continue;
+        }
+        const size_t first = i;
+        while (i + 1 < covered.size() && covered[i + 1]) {
+            ++i;
+        }
+        if (!result.empty()) {
+            result += ',';
+        }
+        result += std::to_string(first);
+        if (i != first) {
+            result += '-';
+            result += std::to_string(i);
+        }
+        ++i;
+    }
+    return result.empty() ? "-" : result;
+}
+
+struct lilicorr_sycl_profile_span {
+    int first_index;
+    int last_index;
+    int count;
+    int64_t begin_us;
+    int64_t end_us;
+    const char * group;
+    const ggml_tensor * first;
+    const ggml_tensor * last;
+};
+
+struct lilicorr_sycl_profile_scope {
+    bool enabled;
+    int first_index;
+    int consumed = 0;
+    int64_t begin_us;
+    const char * group = nullptr;
+    const ggml_tensor * first;
+    const ggml_cgraph * cgraph;
+    std::vector<lilicorr_sycl_profile_span> * records;
+    std::vector<unsigned char> * covered;
+
+    lilicorr_sycl_profile_scope(bool enabled_, int first_index_, const ggml_tensor * first_,
+                                const ggml_cgraph * cgraph_,
+                                std::vector<lilicorr_sycl_profile_span> * records_,
+                                std::vector<unsigned char> * covered_)
+        : enabled(enabled_), first_index(first_index_), begin_us(enabled_ ? lilicorr_sycl_profile_now_us() : 0),
+          first(first_), cgraph(cgraph_), records(records_), covered(covered_) {
+    }
+
+    void consume(int count, const char * group_) {
+        consumed = count;
+        group = group_;
+    }
+
+    ~lilicorr_sycl_profile_scope() {
+        if (!enabled || consumed <= 0) {
+            return;
+        }
+        const int last_index = std::min(first_index + consumed - 1, cgraph->n_nodes - 1);
+        const int64_t end_us = lilicorr_sycl_profile_now_us();
+        records->push_back({first_index, last_index, consumed, begin_us, end_us,
+                            group ? group : "unknown", first, cgraph->nodes[last_index]});
+        for (int i = first_index; i <= last_index; ++i) {
+            (*covered)[i] = 1;
+        }
+    }
+};
