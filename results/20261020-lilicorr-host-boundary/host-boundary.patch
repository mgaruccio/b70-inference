+// Private, development-only LiliCorr Q8 event diagnostic. Not a general profiler.
+#pragma once
+#include <array>
+#include <cinttypes>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <optional>
+#include <type_traits>
+#include <vector>
+
+struct lilicorr_device_record {
+    uint64_t graph;
+    uintptr_t backend_ctx;
+    int node, ordinal, device, k, rows, ncols;
+    int64_t weight_k, weight_m, input_cols;
+    bool quantizer;
+    const char * library_route; // static literals from the executed library branch only
+    std::array<char, GGML_MAX_NAME> name, weight;
+    int64_t submit_begin_us, submit_end_us;
+    const char * status; // literals only; no tensor/stack metadata survives submission
+    std::optional<sycl::event> event;
+};
+
+struct lilicorr_device_pending {
+    static constexpr size_t limit = 2048; // per backend, between existing synchronizations
+    std::vector<lilicorr_device_record> records;
+    ~lilicorr_device_pending() {
+        if (!records.empty()) {
+            GGML_LOG_INFO("LLAMA_LILICORR_DEVICE_TIMING v=1 stage=discard status=no_existing_synchronize records=%zu device_time=unavailable\n", records.size());
+        }
+    }
+};
+
+struct lilicorr_device_scope;
+inline thread_local lilicorr_device_scope * lilicorr_device_active = nullptr;
+
+struct lilicorr_device_scope {
+    lilicorr_device_scope * previous;
+    std::unique_ptr<lilicorr_device_pending> & pending;
+    sycl::queue * queue; // borrowed only for this synchronous dispatch scope
+    uint64_t graph;
+    uintptr_t backend_ctx;
+    int device, nodes, node = -1, submitted = 0, retained = 0, dropped = 0, failed = 0;
+    int64_t weight_k = 0, weight_m = 0, input_cols = 0;
+    bool requested, enabled, selected = false, fc46 = false;
+    std::array<char, GGML_MAX_NAME> name{}, weight{};
+
+    lilicorr_device_scope(bool requested_, bool graphs, std::unique_ptr<lilicorr_device_pending> & pending_,
+                          sycl::queue * queue_, uint64_t graph_, uintptr_t backend_ctx_, int device_, int nodes_)
+        : previous(lilicorr_device_active), pending(pending_), queue(queue_), graph(graph_), backend_ctx(backend_ctx_), device(device_),
+          nodes(nodes_), requested(requested_), enabled(requested_ && !graphs) {
+        // An unscoped/nested target graph must suspend any outer drafter scope.
+        lilicorr_device_active = enabled ? this : nullptr;
+    }
+    ~lilicorr_device_scope() {
+        lilicorr_device_active = previous;
+        if (requested) {
+            GGML_LOG_INFO("LLAMA_LILICORR_DEVICE_TIMING v=1 stage=coverage graph=%" PRIu64 " backend_ctx=0x%" PRIxPTR " device=%d graph_nodes=%d status=%s coverage=q8_reordered_2to8_fc46_host_only submitted=%d retained=%d dropped=%d submit_errors=%d other_device_work=unmeasured\n",
+                          graph, backend_ctx, device, nodes, enabled ? "partial" : "graphs_enabled_unsupported", submitted, retained, dropped, failed);
+        }
+    }
+    lilicorr_device_scope(const lilicorr_device_scope &) = delete;
+    lilicorr_device_scope & operator=(const lilicorr_device_scope &) = delete;
+
+    static void copy_name(std::array<char, GGML_MAX_NAME> & out, const char * in) {
+        std::snprintf(out.data(), out.size(), "%s", in);
+        for (char & c : out) {
+            if (c != '\0' && (static_cast<unsigned char>(c) <= 32 || c == '=')) { c = '_'; }
+        }
+    }
+    void set_node(int index, const ggml_tensor * tensor) {
+        if (!enabled) { return; }
+        node = index;
+        const ggml_tensor * x = tensor->src[0];
+        const ggml_tensor * y = tensor->src[1];
+        fc46 = tensor->op == GGML_OP_MUL_MAT && x && y && x->type == GGML_TYPE_Q8_0 &&
+               std::strcmp(x->name, "fc.weight") == 0 && y->ne[1] == 46;
+        selected = tensor->op == GGML_OP_MUL_MAT && x && y && x->type == GGML_TYPE_Q8_0 &&
+                   ((y->ne[1] >= 2 && y->ne[1] <= 8) || fc46) && y->ne[2] == 1 && y->ne[3] == 1;
+        if (selected) {
+            copy_name(name, tensor->name);
+            copy_name(weight, x->name);
+            weight_k = x->ne[0]; weight_m = x->ne[1]; input_cols = y->ne[1];
+        }
+    }
+};
+
+// Two kernel launch sites and four fc46 library-branch markers only. No commands/waits/queries.
+struct lilicorr_device_submit {
+    lilicorr_device_scope * scope;
+    sycl::queue * queue;
+    bool quantizer, finished = false;
+    const char * library_route;
+    int k, rows, ncols, ordinal;
+    int64_t begin_us;
+
+    lilicorr_device_submit(bool selected, bool quantizer_, sycl::queue * queue_, int k_, int rows_, int ncols_,
+                           const char * library_route_ = nullptr)
+        : scope(selected && lilicorr_device_active && lilicorr_device_active->selected &&
+                (!library_route_ || lilicorr_device_active->fc46) ? lilicorr_device_active : nullptr),
+          queue(queue_), quantizer(quantizer_), library_route(library_route_), k(k_), rows(rows_), ncols(ncols_),
+          ordinal(scope ? ++scope->submitted : 0), begin_us(scope ? ggml_time_us() : 0) {}
+    ~lilicorr_device_submit() {
+        if (scope && !finished) { ++scope->failed; } // original submission exception still propagates
+    }
+    void finish(const sycl::event & event) noexcept { store(&event); }
+    void finish_library() noexcept { store(nullptr); } // original library API has no event here
+    void store(const sycl::event * event) noexcept {
+        if (!scope) { return; }
+        const int64_t end_us = ggml_time_us(); // before metadata/storage overhead
+        finished = true;
+        try {
+            if (!scope->pending) { scope->pending = std::make_unique<lilicorr_device_pending>(); }
+            auto & records = scope->pending->records;
+            if (records.size() == lilicorr_device_pending::limit) { ++scope->dropped; return; }
+            const bool same_queue = queue == scope->queue;
+            const bool profiling = event && same_queue && queue->has_property<sycl::property::queue::enable_profiling>();
+            const char * status = !event ? "device_unavailable_library" :
+                !same_queue ? "foreign_queue" : !profiling ? "unsupported_profiling" : "pending";
+            lilicorr_device_record record{scope->graph, scope->backend_ctx, scope->node, ordinal, scope->device, k, rows, ncols,
+                                         scope->weight_k, scope->weight_m, scope->input_cols, quantizer, library_route,
+                                         scope->name, scope->weight, begin_us, end_us, status, std::nullopt};
+            if (profiling) { record.event = *event; }
+            records.push_back(std::move(record));
+            ++scope->retained;
+        } catch (...) {
+            ++scope->dropped; // allocation/event-copy/property errors are missing data, never zero device time
+        }
+    }
+};
+
+// Call ONLY after ggml_backend_sycl_synchronize's original queue wait has returned.
+// All retained events came from this backend's primary queue. No extra wait, even on error.
+inline void lilicorr_device_after_wait(std::unique_ptr<lilicorr_device_pending> & slot,
