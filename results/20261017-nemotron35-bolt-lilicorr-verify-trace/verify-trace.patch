+static bool bolt_verify_enabled() {
+    const char * dir = std::getenv("BOLT_VERIFY_CAPTURE_DIR");
+    return dir && dir[0];
+}
+
+static std::string bolt_verify_ids(const std::vector<int32_t> & ids) {
+    std::string result;
+    for (auto id : ids) {
+        if (!result.empty()) { result += ','; }
+        result += std::to_string(id);
+    }
+    return result.empty() ? "-" : result;
+}
+
+static void bolt_verify_batch(llama_context * ctx, const common_batch & b, int off) {
+    if (!bolt_verify_enabled()) { return; }
+    std::string tokens, pos, outputs, seq;
+    for (int i = 0; i < b.size(); ++i) {
+        if (i) { tokens += ','; pos += ','; outputs += ','; seq += ','; }
+        const auto & t = b.tokens[i];
+        tokens += std::to_string(t.id);
+        pos += std::to_string(t.pos[0]);
+        outputs += std::to_string(int(t.output));
+        seq += std::to_string(t.seq_id);
+        for (auto id : t.seq_ids_extra) { seq += '/' + std::to_string(id); }
+    }
+    LOG_INF("BOLT_VERIFY batch ctx=%p off=%d n=%d tokens=%s pos=%s outputs=%s seq=%s\n",
+            (void *) ctx, off, b.size(), tokens.c_str(), pos.c_str(), outputs.c_str(), seq.c_str());
+}
