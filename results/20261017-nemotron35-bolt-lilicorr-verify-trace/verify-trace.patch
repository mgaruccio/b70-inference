+// Temporary, default-off CPU-logits diagnostic. Never request a backend readback.
+static std::string bolt_verify_write(const char * dir, const float * logits, int n_vocab) {
+    if (!logits) {
+        return "-";
+    }
+    std::string path = std::string(dir) + "/row-XXXXXX";
+    std::vector<char> name(path.begin(), path.end());
+    name.push_back('\0');
+    const int fd = mkstemp(name.data());
+    if (fd < 0) {
+        LOG_ERR("BOLT_VERIFY error op=mkstemp errno=%d\n", errno);
+        return "-";
+    }
+    bool ok = fchmod(fd, 0644) == 0; // host user can read container-owned files
+    const char * bytes = reinterpret_cast<const char *>(logits);
+    size_t left = size_t(n_vocab) * sizeof(float);
+    while (ok && left) {
+        const ssize_t n = write(fd, bytes, left);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            ok = false;
+            break;
+        }
+        bytes += n;
+        left -= size_t(n);
+    }
+    const int saved_errno = errno;
+    if (close(fd) != 0 || !ok) {
+        LOG_ERR("BOLT_VERIFY error op=write_close errno=%d\n", ok ? errno : saved_errno);
+        return "-"; // keep any partial file as failed-run evidence
+    }
+    path = name.data();
+    return path.substr(path.find_last_of('/') + 1);
+}
