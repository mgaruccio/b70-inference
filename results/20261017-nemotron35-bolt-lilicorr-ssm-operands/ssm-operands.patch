+// Temporary, default-off first-block observer. No dispatch/reorder/math changes.
+// The controller arms exactly one diagnostic; subsequent decode calls are ignored.
+struct bolt_ssm_capture {
+    const ggml_tensor * tensors[3] = {};
+    const void * data[3] = {};
+    size_t bytes[3] = {};
+    queue_ptr queue = nullptr;
+    const char * stem = nullptr;
+    std::string directory;
+    int n = 0;
+};
+
+static void bolt_ssm_require(bool ok, const char * reason) {
+    if (!ok) GGML_ABORT("BOLT_SSM_OPERAND error=%s", reason);
+}
+
+static size_t bolt_ssm_span(const ggml_backend_sycl_context & ctx, const ggml_tensor * t,
+                            int64_t rows, int64_t columns, bool weight) {
+    // Exact bounded shapes BEFORE products, sizes or buffer pointer arithmetic.
+    bolt_ssm_require(t && t->ne[0] == rows && t->ne[1] == columns &&
+                     t->ne[2] == 1 && t->ne[3] == 1, "shape");
+    bolt_ssm_require(t->type == (weight ? GGML_TYPE_NVFP4 : GGML_TYPE_F32), "type");
+    const size_t block = weight ? sizeof(block_nvfp4) : sizeof(float);
+    const size_t row = weight ? rows / QK_NVFP4 * block : rows * block;
+    const size_t bytes = row * columns;
+    bolt_ssm_require(t->nb[0] == block && t->nb[1] == row && t->nb[2] == bytes &&
+                     t->nb[3] == bytes && ggml_is_contiguous(t), "layout");
+    bolt_ssm_require(t->data && t->buffer && ggml_backend_buffer_is_sycl(t->buffer) &&
+                     t->buffer->context &&
+                     static_cast<const ggml_backend_sycl_buffer_context *>(t->buffer->context)->device == ctx.device,
+                     "device_buffer");
+    const uintptr_t base = (uintptr_t) ggml_backend_buffer_get_base(t->buffer);
+    const uintptr_t data = (uintptr_t) t->data;
+    const size_t size = ggml_backend_buffer_get_size(t->buffer);
+    bolt_ssm_require(base && data % (weight ? 16 : 4) == 0 && data >= base &&
+                     data - base <= size && bytes <= size - (data - base), "span");
+    return bytes;
+}
+
+static void bolt_ssm_copy(const bolt_ssm_capture & capture, ggml_backend_sycl_context & ctx, int index) {
+    const char * roles[] = {"weight", "src1", "dst"};
+    const ggml_tensor * t = capture.tensors[index];
+    const size_t bytes = capture.bytes[index];
+    const std::string file = std::string(capture.stem) + "." + roles[index] + ".bin";
+    const std::string path = capture.directory + "/" + file;
+    // Exclusive creation makes stale/partial paths fatal, never a silent overwrite.
+    const int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0644);
+    bolt_ssm_require(fd >= 0, "exclusive_file");
+    try {
+        std::vector<uint8_t> host(bytes);
+        try {
+            capture.queue->memcpy(host.data(), capture.data[index], bytes).wait_and_throw();
+        } catch (...) {
+            // Even on a submission/async exception, host storage survives queue completion.
+            capture.queue->wait();
+            throw;
+        }
+        size_t done = 0;
+        while (done < bytes) {
+            const ssize_t n = write(fd, host.data() + done, bytes - done);
+            if (n < 0 && errno == EINTR) continue;
+            bolt_ssm_require(n > 0, "write");
+            done += (size_t) n;
+        }
+    } catch (...) {
+        close(fd);
+        throw;
+    }
+    bolt_ssm_require(close(fd) == 0, "close");
+    const uintptr_t base = (uintptr_t) ggml_backend_buffer_get_base(t->buffer);
+    GGML_LOG_INFO("BOLT_SSM_OPERAND phase=%s weight=%s role=%s backend_ctx=%p queue=%p device=%d n=%d "
+                  "type=%s reorder=1 ne0=%" PRId64 " ne1=%" PRId64 " ne2=%" PRId64 " ne3=%" PRId64 " "
+                  "nb0=%zu nb1=%zu nb2=%zu nb3=%zu data=%p base=%p buffer_bytes=%zu offset=%zu bytes=%zu file=%s\n",
+                  index == 2 ? "after" : "before", capture.tensors[0]->name, roles[index],
+                  (void *) &ctx, (void *) capture.queue, ctx.device, capture.n, ggml_type_name(t->type),
+                  t->ne[0], t->ne[1], t->ne[2], t->ne[3], t->nb[0], t->nb[1], t->nb[2], t->nb[3],
+                  t->data, (void *) base, ggml_backend_buffer_get_size(t->buffer),
+                  (size_t) ((uintptr_t) t->data - base), bytes, file.c_str());
+}
+
+static bolt_ssm_capture bolt_ssm_before(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    bolt_ssm_capture capture;
+    const char * directory = std::getenv("BOLT_SSM_OPERAND_DIR");
+    if (!directory || !*directory) return capture;
+    const ggml_tensor * w = dst->src[0];
+    const ggml_tensor * x = dst->src[1];
+    const bool input = std::strcmp(w->name, "blk.0.ssm_in.weight") == 0;
+    if (!input && std::strcmp(w->name, "blk.0.ssm_out.weight") != 0) return capture;
+    if (x->ne[1] < 1 || x->ne[1] > 2) return capture; // Never prefill.
+    bolt_ssm_require(std::strcmp(directory, "/ssm-operands") == 0, "directory");
+    const std::string marker = std::string(directory) + "/armed";
+    const int fd = open(marker.c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+    if (fd < 0 && errno == ENOENT) return capture; // Native, warmup, ordinary: unarmed.
+    bolt_ssm_require(fd >= 0, "marker_open");
+    struct stat st;
+    char width[3] = {};
+    const bool valid = fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_size == 2 &&
+                       read(fd, width, sizeof(width)) == 2;
+    const int closed = close(fd);
+    bolt_ssm_require(valid && closed == 0 && width[1] == '\n' &&
+                     (width[0] == '1' || width[0] == '2'), "marker_contents");
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    static bool seen[2] = {false, false};
+    static const ggml_backend_sycl_context * backend = nullptr;
+    static int n = 0;
+    const int slot = input ? 0 : 1;
+    if (seen[slot]) return capture;
+    bolt_ssm_require(x->ne[1] == width[0] - '0', "armed_width");
+    bolt_ssm_require(!backend || (backend == &ctx && n == x->ne[1]), "backend_changed");
+    bolt_ssm_require(input ? !seen[1] : seen[0], "projection_order");
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(w->extra);
+    bolt_ssm_require(extra && extra->optimized_feature.reorder, "not_already_reordered");
+    const int64_t k = input ? 4096 : 8192;
+    const int64_t m = input ? 18560 : 4096;
+    capture.bytes[0] = bolt_ssm_span(ctx, w, k, m, true);
+    capture.bytes[1] = bolt_ssm_span(ctx, x, k, x->ne[1], false);
+    capture.bytes[2] = bolt_ssm_span(ctx, dst, m, x->ne[1], false);
+    capture.queue = ctx.stream(); // Non-split contiguous path: ctx.stream(device, 0).
+    bolt_ssm_require(capture.queue && capture.queue->is_in_order(), "queue_order");
+    capture.stem = input ? "ssm_in" : "ssm_out";
+    capture.directory = directory;
+    capture.n = (int) x->ne[1];
+    capture.tensors[0] = w;
+    capture.tensors[1] = x;
+    capture.tensors[2] = dst;
+    for (int i = 0; i < 3; ++i) capture.data[i] = capture.tensors[i]->data;
+    backend = &ctx;
+    n = capture.n;
+    seen[slot] = true; // Once even if a copy fails; failures abort, never retry.
+    // opt_for_reorder skips an already-reordered weight. MMVQ never writes it.
+    // These are precisely src0_dd_i and src1_ddf_i on the checked one-device path.
+    bolt_ssm_copy(capture, ctx, 0);
+    bolt_ssm_copy(capture, ctx, 1);
+    return capture;
+}
+
+static void bolt_ssm_after(const bolt_ssm_capture & capture, ggml_backend_sycl_context & ctx) {
+    if (!capture.stem) return;
+    bolt_ssm_require(capture.queue == ctx.stream(), "queue_changed");
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(capture.tensors[0]->extra);
+    bolt_ssm_require(extra && extra->optimized_feature.reorder, "reorder_changed");
+    const bool input = std::strcmp(capture.stem, "ssm_in") == 0;
+    for (int i = 0; i < 3; ++i) {
+        const int64_t rows = i == 2 ? (input ? 18560 : 4096) : (input ? 4096 : 8192);
+        const int64_t cols = i == 0 ? (input ? 18560 : 4096) : capture.n;
+        bolt_ssm_require(capture.tensors[i]->data == capture.data[i] &&
+                         bolt_ssm_span(ctx, capture.tensors[i], rows, cols, i == 0) == capture.bytes[i],
+                         "operand_changed");
+    }
+    bolt_ssm_copy(capture, ctx, 2); // Completion on the SAME queue before host storage release.
 }

