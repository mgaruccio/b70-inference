+static std::string ggml_sycl_grouped_iq2_diag_json_quote(const char * value) {
+    std::string out = "\"";
+    if (value) {
+        for (const char raw : std::string(value)) {
+            const unsigned char c = (unsigned char) raw;
+            switch (c) {
+                case '"': out += "\\\""; break;
+                case '\\': out += "\\\\"; break;
+                case '\b': out += "\\b"; break;
+                case '\f': out += "\\f"; break;
+                case '\n': out += "\\n"; break;
+                case '\r': out += "\\r"; break;
+                case '\t': out += "\\t"; break;
+                default:
+                    if (c < 0x20) {
+                        static constexpr char hex[] = "0123456789abcdef";
+                        out += "\\u00";
+                        out += hex[c >> 4];
+                        out += hex[c & 0xf];
+                    } else {
+                        out += (char) c;
+                    }
+                    break;
+            }
+        }
+    }
+    out += "\"";
+    return out;
+}
+
+static std::string ggml_sycl_grouped_iq2_diag_array(const std::vector<int64_t> & values, bool tails) {
+    std::string out = "[";
+    for (size_t i = 0; i < values.size(); ++i) {
+        if (i != 0) {
+            out += ",";
+        }
+        out += std::to_string(tails ? values[i] % 32 : values[i]);
+    }
+    out += "]";
+    return out;
+}
+
+static int64_t ggml_sycl_grouped_iq2_diag_tiles32(const std::vector<int64_t> & row_counts) {
+    int64_t tiles = 0;
+    for (const int64_t rows : row_counts) {
+        tiles += (rows + 31) / 32;
+    }
+    return tiles;
+}
