+static std::string fg_iq2_diag_json_quote(const std::string & value) {
+    std::string out = "\"";
+    for (const char raw : value) {
+        const unsigned char c = (unsigned char) raw;
+        if (c == '"') {
+            out += "\\\"";
+        } else if (c == '\\') {
+            out += "\\\\";
+        } else {
+            out += raw;
+        }
+    }
+    out += "\"";
+    return out;
+}
+
+static std::string fg_iq2_diag_rows(const int64_t * expert_row_offsets, int64_t n_as, bool tails) {
+    std::string out = "[";
+    for (int64_t e = 0; e < n_as; ++e) {
+        if (e != 0) {
+            out += ",";
+        }
+        const int64_t rows = expert_row_offsets[e + 1] - expert_row_offsets[e];
+        out += std::to_string(tails ? rows % 32 : rows);
+    }
+    out += "]";
+    return out;
+}
+
+static int64_t fg_iq2_diag_tiles32(const int64_t * expert_row_offsets, int64_t n_as) {
+    int64_t tiles = 0;
+    for (int64_t e = 0; e < n_as; ++e) {
+        const int64_t rows = expert_row_offsets[e + 1] - expert_row_offsets[e];
+        tiles += (rows + 31) / 32;
+    }
+    return tiles;
+}
+
+static void fg_iq2_diag_emit(const char * reason, bool grouped, int combo, int64_t n_tiles,
+                             const int64_t * expert_row_offsets, int64_t n_as, int64_t M, int64_t K,
+                             int64_t total_rows, int64_t n_active, bool reordered, int32_t src1_prec) {
+    if (!g_ggml_sycl_debug) {
+        return;
+    }
+
+    int         BN = 0;
+    int         SG_ROWS = 0;
+    std::string combo_name;
+    if (combo >= 0) {
+        fg_visit_combo(combo, [&](auto s) {
+            using S = decltype(s);
+            BN = S::BN;
+            SG_ROWS = S::SG_ROWS;
+        });
+        if (BN > 0) {
+            combo_name = fg_combo_name(combo);
+        }
+    }
+    const int64_t padded_columns = BN > 0 && n_tiles >= 0 ? n_tiles * BN : -1;
+    const std::string json =
+        "{\"event\":\"inner_result\",\"schema\":\"grouped_iq2_diag/v1\""
+        ",\"decision\":" + fg_iq2_diag_json_quote(grouped ? "grouped" : "fallback") +
+        ",\"reason\":" + fg_iq2_diag_json_quote(reason) +
+        ",\"M\":" + std::to_string(M) +
+        ",\"K\":" + std::to_string(K) +
+        ",\"experts\":" + std::to_string(n_as) +
+        ",\"total_rows\":" + std::to_string(total_rows) +
+        ",\"n_active\":" + std::to_string(n_active) +
+        ",\"row_counts\":" + fg_iq2_diag_rows(expert_row_offsets, n_as, false) +
+        ",\"tiles_bn32\":" + std::to_string(fg_iq2_diag_tiles32(expert_row_offsets, n_as)) +
+        ",\"tail_rows_bn32\":" + fg_iq2_diag_rows(expert_row_offsets, n_as, true) +
+        ",\"valid_columns\":" + std::to_string(total_rows) +
+        ",\"padded_columns\":" + (padded_columns >= 0 ? std::to_string(padded_columns) : "null") +
+        ",\"n_tiles\":" + (n_tiles >= 0 ? std::to_string(n_tiles) : "null") +
+        ",\"selected_combo\":" + (combo >= 0 ? std::to_string(combo) : "null") +
+        ",\"combo_name\":" + (combo_name.empty() ? "null" : fg_iq2_diag_json_quote(combo_name)) +
+        ",\"BN\":" + (BN > 0 ? std::to_string(BN) : "null") +
+        ",\"SG_ROWS\":" + (SG_ROWS > 0 ? std::to_string(SG_ROWS) : "null") +
+        ",\"reordered\":" + (reordered ? "true" : "false") +
+        ",\"src1_precision\":" + std::to_string(src1_prec) + "}";
+    GGML_SYCL_DEBUG("[SYCL_GROUPED_IQ2_DIAG] %s\n", json.c_str());
+}
