@@ -0,0 +1,155 @@
+// Private, development-only LiliCorr Q8 event diagnostic. Not a general profiler.
+#pragma once
+#include <array>
+#include <cinttypes>
+#include <cstdio>
+#include <memory>
+#include <optional>
+#include <type_traits>
+#include <vector>
+
+struct lilicorr_device_record {
+    uint64_t graph;
+    int node, ordinal, device, k, rows;
+    bool quantizer;
+    std::array<char, GGML_MAX_NAME> name, weight;
+    int64_t submit_begin_us, submit_end_us;
+    const char * status; // literals only; no tensor/stack metadata survives submission
+    std::optional<sycl::event> event;
+};
+
+struct lilicorr_device_pending {
+    static constexpr size_t limit = 2048; // per backend, between existing synchronizations
+    std::vector<lilicorr_device_record> records;
+    ~lilicorr_device_pending() {
+        if (!records.empty()) {
+            GGML_LOG_INFO("LLAMA_LILICORR_DEVICE_TIMING v=1 stage=discard status=no_existing_synchronize records=%zu device_time=unavailable\n", records.size());
+        }
+    }
+};
+
+struct lilicorr_device_scope;
+inline thread_local lilicorr_device_scope * lilicorr_device_active = nullptr;
+
+struct lilicorr_device_scope {
+    lilicorr_device_scope * previous;
+    std::unique_ptr<lilicorr_device_pending> & pending;
+    sycl::queue * queue; // borrowed only for this synchronous dispatch scope
+    uint64_t graph;
+    int device, nodes, node = -1, submitted = 0, retained = 0, dropped = 0, failed = 0;
+    bool requested, enabled, selected = false;
+    std::array<char, GGML_MAX_NAME> name{}, weight{};
+
+    lilicorr_device_scope(bool requested_, bool graphs, std::unique_ptr<lilicorr_device_pending> & pending_,
+                          sycl::queue * queue_, uint64_t graph_, int device_, int nodes_)
+        : previous(lilicorr_device_active), pending(pending_), queue(queue_), graph(graph_), device(device_),
+          nodes(nodes_), requested(requested_), enabled(requested_ && !graphs) {
+        // An unscoped/nested target graph must suspend any outer drafter scope.
+        lilicorr_device_active = enabled ? this : nullptr;
+    }
+    ~lilicorr_device_scope() {
+        lilicorr_device_active = previous;
+        if (requested) {
+            GGML_LOG_INFO("LLAMA_LILICORR_DEVICE_TIMING v=1 stage=coverage graph=%" PRIu64 " device=%d graph_nodes=%d status=%s coverage=q8_reordered_ncols8_only submitted=%d retained=%d dropped=%d submit_errors=%d other_device_work=unmeasured\n",
+                          graph, device, nodes, enabled ? "partial" : "graphs_enabled_unsupported", submitted, retained, dropped, failed);
+        }
+    }
+    lilicorr_device_scope(const lilicorr_device_scope &) = delete;
+    lilicorr_device_scope & operator=(const lilicorr_device_scope &) = delete;
+
+    static void copy_name(std::array<char, GGML_MAX_NAME> & out, const char * in) {
+        std::snprintf(out.data(), out.size(), "%s", in);
+        for (char & c : out) {
+            if (c != '\0' && (static_cast<unsigned char>(c) <= 32 || c == '=')) { c = '_'; }
+        }
+    }
+    void set_node(int index, const ggml_tensor * tensor) {
+        if (!enabled) { return; }
+        node = index;
+        const ggml_tensor * x = tensor->src[0];
+        const ggml_tensor * y = tensor->src[1];
+        selected = tensor->op == GGML_OP_MUL_MAT && x && y && x->type == GGML_TYPE_Q8_0 &&
+                   y->ne[1] == 8 && y->ne[2] == 1 && y->ne[3] == 1;
+        if (selected) {
+            copy_name(name, tensor->name);
+            copy_name(weight, x->name);
+        }
+    }
+};
+
+// Two direct call sites only. This never submits commands, waits, or queries an event.
+struct lilicorr_device_submit {
+    lilicorr_device_scope * scope;
+    sycl::queue * queue;
+    bool quantizer, finished = false;
+    int k, rows, ordinal;
+    int64_t begin_us;
+
+    lilicorr_device_submit(bool selected, bool quantizer_, sycl::queue * queue_, int k_, int rows_)
+        : scope(selected && lilicorr_device_active && lilicorr_device_active->selected ? lilicorr_device_active : nullptr),
+          queue(queue_), quantizer(quantizer_), k(k_), rows(rows_), ordinal(scope ? ++scope->submitted : 0),
+          begin_us(scope ? ggml_time_us() : 0) {}
+    ~lilicorr_device_submit() {
+        if (scope && !finished) { ++scope->failed; } // original submission exception still propagates
+    }
+    void finish(const sycl::event & event) noexcept {
+        if (!scope) { return; }
+        const int64_t end_us = ggml_time_us(); // before metadata/storage overhead
+        finished = true;
+        try {
+            if (!scope->pending) { scope->pending = std::make_unique<lilicorr_device_pending>(); }
+            auto & records = scope->pending->records;
+            if (records.size() == lilicorr_device_pending::limit) { ++scope->dropped; return; }
+            const bool same_queue = queue == scope->queue;
+            const bool profiling = same_queue && queue->has_property<sycl::property::queue::enable_profiling>();
+            const char * status = !same_queue ? "foreign_queue" : !profiling ? "unsupported_profiling" : "pending";
+            lilicorr_device_record record{scope->graph, scope->node, ordinal, scope->device, k, rows, quantizer,
+                                         scope->name, scope->weight, begin_us, end_us, status, std::nullopt};
+            if (profiling) { record.event = event; }
+            records.push_back(std::move(record));
+            ++scope->retained;
+        } catch (...) {
+            ++scope->dropped; // allocation/event-copy/property errors are missing data, never zero device time
+        }
+    }
+};
+
+// Call ONLY after ggml_backend_sycl_synchronize's original queue wait has returned.
+// All retained events came from this backend's primary queue. No extra wait, even on error.
+inline void lilicorr_device_after_wait(std::unique_ptr<lilicorr_device_pending> & slot,
+                                      int64_t wait_begin_us, int64_t wait_end_us) {
+    if (!slot) { return; }
+    auto pending = std::move(slot);
+    const int64_t query_begin_us = ggml_time_us();
+    for (const auto & record : pending->records) {
+        const char * status = record.status;
+        char device_fields[192] = "device_start_ns=unavailable device_end_ns=unavailable device_elapsed_ns=unavailable";
+        if (record.event) {
+            try {
+                // Nonblocking defensive check: never let a profiling query create an implicit wait.
+                if (record.event->get_info<sycl::info::event::command_execution_status>() != sycl::info::event_command_status::complete) {
+                    status = "not_complete_after_wait";
+                } else {
+                    const uint64_t start = record.event->get_profiling_info<sycl::info::event_profiling::command_start>();
+                    const uint64_t end = record.event->get_profiling_info<sycl::info::event_profiling::command_end>();
+                    if (start == 0 || end < start) {
+                        status = "invalid_timestamps";
+                    } else {
+                        status = "ok";
+                        std::snprintf(device_fields, sizeof(device_fields), "device_start_ns=%" PRIu64 " device_end_ns=%" PRIu64 " device_elapsed_ns=%" PRIu64, start, end, end - start);
+                    }
+                }
+            } catch (...) {
+                status = "profiling_query_error";
+            }
+        }
+        GGML_LOG_INFO("LLAMA_LILICORR_DEVICE_TIMING v=1 stage=event graph=%" PRIu64 " node=%d ordinal=%d device=%d kernel=%s name=%s weight=%s k=%d rows=%d ncols=8 coverage=selected_kernel_only status=%s submit_begin_us=%" PRId64 " submit_end_us=%" PRId64 " submit_host_us=%" PRId64 " %s\n",
+                      record.graph, record.node, record.ordinal, record.device, record.quantizer ? "quantize_reorder_q8_1" : "mmvq_reordered_q8_0",
+                      record.name.data(), record.weight.data(), record.k, record.rows, status,
+                      record.submit_begin_us, record.submit_end_us, record.submit_end_us - record.submit_begin_us, device_fields);
+    }
+    const int64_t query_end_us = ggml_time_us();
+    GGML_LOG_INFO("LLAMA_LILICORR_DEVICE_TIMING v=1 stage=drain status=existing_wait_returned attribution=shared_queue_not_pure_drafter wait_begin_us=%" PRId64 " wait_end_us=%" PRId64 " wait_host_us=%" PRId64 " query_and_log_host_us=%" PRId64 " records=%zu other_device_work=unmeasured\n",
+                  wait_begin_us, wait_end_us, wait_end_us - wait_begin_us, query_end_us - query_begin_us, pending->records.size());
+    pending->records.clear(); // releases all event references; backend slot stays empty
+}
