+// Named Q8_0/F32 CPU-reference regressions for the bounded attention DMMV control.
+// Reuse latent_dmmv2 initialization, tolerance, and CPU reference unchanged.
+struct test_mul_mat_attention_dmmv2 : public test_mul_mat {
+    const char * weight;
+
+    test_mul_mat_attention_dmmv2(const char * weight, int64_t m, int64_t n, int64_t k) :
+        test_mul_mat(GGML_TYPE_Q8_0, GGML_TYPE_F32, m, n, k, {1, 1}, {1, 1}), weight(weight) {}
+
+    std::string vars() override {
+        return std::string("attention_dmmv2=1,weight=") + weight + "," + test_mul_mat::vars();
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, k, m);
+        ggml_set_name(a, weight);
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        return ggml_mul_mat(ctx, a, b);
+    }
+};
