+// Native fixtures exercise the actual flash-attention F32 3D-to-2D reshape view.
+struct test_mul_mat_attention_view_dmmv2 : public test_mul_mat {
+    const char * weight;
+
+    test_mul_mat_attention_view_dmmv2(const char * weight, int64_t n) :
+        test_mul_mat(GGML_TYPE_Q8_0, GGML_TYPE_F32, 4096, n, 4096, {1, 1}, {1, 1}), weight(weight) {}
+
+    std::string vars() override {
+        return std::string("attention_view_dmmv2=1,weight=") + weight + "," + test_mul_mat::vars();
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, k, m);
+        ggml_set_name(a, weight);
+        const bool partial = strcmp(weight, "blk.7.prefix.attn_output.weight") == 0 ||
+                             strcmp(weight, "blk.7.offset.attn_output.weight") == 0;
+        ggml_tensor * base = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 128, 32, partial ? 3 : n);
+        ggml_tensor * view = nullptr;
+        if (partial) {
+            const size_t offset = strcmp(weight, "blk.7.offset.attn_output.weight") == 0 ? base->nb[2] : 0;
+            view = ggml_view_2d(ctx, base, 4096, 2, base->nb[2], offset);
+            view = ggml_reshape_2d(ctx, view, 4096, 2);
+        } else {
+            view = ggml_reshape_2d(ctx, base, 4096, n);
+        }
+        return ggml_mul_mat(ctx, a, view);
+    }
+};
