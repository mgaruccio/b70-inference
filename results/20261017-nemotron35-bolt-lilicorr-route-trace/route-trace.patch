+// Temporary, default-off host-only dispatch diagnostics.  The capture environment is
+// already owned by the BOLT_VERIFY observer; this logger never reads device memory or
+// changes a dispatch decision.  Tensor copies used by MUL_MAT_ID retain the source name.
+static bool bolt_route_enabled() {
+    const char * dir = std::getenv("BOLT_VERIFY_CAPTURE_DIR");
+    return dir && dir[0];
+}
+
+static bool bolt_route_selected_weight(const ggml_tensor * weight) {
+    if (!weight || !weight->name[0]) {
+        return false;
+    }
+    return std::strncmp(weight->name, "blk.0.", 6) == 0 ||
+           std::strcmp(weight->name, "output.weight") == 0;
+}
+
+static const char * bolt_route_name(const ggml_tensor * tensor) {
+    return tensor && tensor->name[0] ? tensor->name : "-";
+}
+
+static const char * bolt_route_type_name(const ggml_tensor * tensor) {
+    return tensor ? ggml_type_name(tensor->type) : "-";
+}
+
+static const char * bolt_route_op_name(const ggml_tensor * tensor) {
+    return tensor ? ggml_op_name(tensor->op) : "-";
+}
+
+static int64_t bolt_route_ne(const ggml_tensor * tensor, int dim) {
+    return tensor ? tensor->ne[dim] : 0;
+}
+
+static size_t bolt_route_nb(const ggml_tensor * tensor, int dim) {
+    return tensor ? tensor->nb[dim] : 0;
+}
+
+static bool bolt_route_reordered(const ggml_tensor * weight) {
+    const auto * extra = weight ? static_cast<const ggml_tensor_extra_gpu *>(weight->extra) : nullptr;
+    return extra && extra->optimized_feature.reorder;
+}
+
+static int32_t bolt_route_requested_precision(const ggml_tensor * dst) {
+    return dst ? ggml_sycl_src1_prec(dst) : -1;
+}
+
+static int32_t bolt_route_dynamic_effective_precision() {
+    switch (g_ggml_sycl_dynamic_precision) {
+        case GGML_SYCL_DYNAMIC_PRECISION_F16:  return GGML_PREC_F16;
+        case GGML_SYCL_DYNAMIC_PRECISION_BF16: return GGML_PREC_BF16;
+        case GGML_SYCL_DYNAMIC_PRECISION_TF32: return -2; // no GGML_PREC_TF32 enum
+        default:                               return GGML_PREC_F32;
+    }
+}
+
+static void bolt_route_record(const char * route,
+                              const ggml_backend_sycl_context & ctx,
+                              const ggml_tensor * weight,
+                              const ggml_tensor * src1,
+                              const ggml_tensor * dst,
+                              int device,
+                              int32_t requested_precision,
+                              int32_t effective_precision,
+                              const ggml_tensor * aux_weight,
+                              int64_t expert,
+                              int result) {
+    if (!bolt_route_enabled() || !bolt_route_selected_weight(weight)) {
+        return;
+    }
+
+    fprintf(stderr,
+            "BOLT_ROUTE route=%s weight=%s aux_weight=%s op=%s src0_type=%s aux_type=%s "
+            "src1_type=%s dst_type=%s ne0=%" PRId64 " ne1=%" PRId64 " ne2=%" PRId64 " ne3=%" PRId64 " "
+            "nb0=%zu nb1=%zu nb2=%zu nb3=%zu reorder=%d requested_prec=%" PRId32 " effective_prec=%" PRId32 " "
+            "dynamic_prec=%d device=%d backend_ctx=%p expert=%" PRId64 " result=%d\n",
+            route, bolt_route_name(weight), bolt_route_name(aux_weight), bolt_route_op_name(dst),
+            bolt_route_type_name(weight), bolt_route_type_name(aux_weight), bolt_route_type_name(src1),
+            bolt_route_type_name(dst),
+            bolt_route_ne(weight, 0), bolt_route_ne(weight, 1), bolt_route_ne(weight, 2), bolt_route_ne(weight, 3),
+            bolt_route_nb(weight, 0), bolt_route_nb(weight, 1), bolt_route_nb(weight, 2), bolt_route_nb(weight, 3),
+            bolt_route_reordered(weight) ? 1 : 0, requested_precision, effective_precision,
+            g_ggml_sycl_dynamic_precision, device, static_cast<const void *>(&ctx), expert, result);
+}
+
+static void bolt_route_record_gateup(const char * route,
+                                     ggml_backend_sycl_context & ctx,
+                                     const ggml_tensor * wu,
+                                     const ggml_tensor * wg,
+                                     const ggml_tensor * act,
+                                     const ggml_tensor * glu) {
+    const ggml_tensor * weight = bolt_route_selected_weight(wu) ? wu : wg;
+    const ggml_tensor * aux = weight == wu ? wg : wu;
+    bolt_route_record(route, ctx, weight, act, glu, ctx.device, -1, -1, aux, -1, -1);
+}
+
+static const char * bolt_route_dmmv_kind(const ggml_tensor * weight, bool reordered) {
+#if defined(GGML_SYCL_DMMV_HAS_ESIMD)
+    if (reordered && g_ggml_sycl_enable_esimd) {
+        switch (weight->type) {
+            case GGML_TYPE_Q2_K:
+            case GGML_TYPE_Q3_K:
+            case GGML_TYPE_Q4_K:
+            case GGML_TYPE_Q5_K:
+            case GGML_TYPE_Q6_K:
+            case GGML_TYPE_Q8_0:
+                return "DMMV_ESIMD";
+            default:
+                break;
+        }
+    }
+#else
+    GGML_UNUSED(weight);
+#endif
+    return reordered ? "DMMV_REORDERED" : "DMMV_PLAIN";
+}
