  "content": "def merge_intervals(items):\n    if not items:\n        return []\n    sorted_items = sorted(items, key=lambda x: x[0])\n    merged = []\n    for start, end in sorted_items:\n        if not merged or start > merged[-1][1]:\n            merged.append([start, end])\n        else:\n            merged[-1][1] = max(merged[-1][1], end)\n    return merged",
