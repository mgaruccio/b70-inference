+            if (t != probs) {
+                for (const ggml_tensor * src : t->src) {
+                    if (src == logits) {
+                        return true;
+                    }
+                }
+            }
+            const ggml_tensor * owner = t;
+            while (owner && (owner->op == GGML_OP_VIEW || owner->op == GGML_OP_RESHAPE ||
+                             owner->op == GGML_OP_PERMUTE || owner->op == GGML_OP_TRANSPOSE)) {
+                owner = owner->src[0];
+            }
