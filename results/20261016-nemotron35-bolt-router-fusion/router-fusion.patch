+            if (owner != indices) {
+                for (const ggml_tensor * v = t->view_src; v; v = v->view_src) {
+                    if (v == logits) {
+                        return true;
+                    }
+                }
+            }
+            return false;
+        };
+        for (int j = 0; j < graph->n_nodes; ++j) {
+            if (live_logit(graph->nodes[j])) {
+                return false;
+            }
+        }
+        for (int j = 0; j < graph->n_leafs; ++j) {
+            if (live_logit(graph->leafs[j])) {
+                return false;
+            }
+        }
+    }
+
+    const int ncols = (int) nc;
+    const int nrows = (int) probs->ne[1];
+    const int ncols_pad = next_power_of_2(ncols);
+    const size_t shared_mem = (size_t) ncols_pad * sizeof(int);
+    if (shared_mem > ggml_sycl_info().devices[ctx.device].smpbo) {
+        return false;
+    }
+    // Match argsort_f32_i32_sycl's local path and tasks-per-thread exactly.
+    const int max_block_size = ggml_sycl_info().max_work_group_sizes[ctx.device];
+    int nth = 1;
+    while (nth < ncols_pad && nth < max_block_size) {
+        nth *= 2;
+    }
+    if (nth > max_block_size) {
+        nth = max_block_size;
+    }
+    if (nth <= 0 || ncols_pad % nth != 0) {
+        return false;
+    }
+    const int tasks_per_thread = ncols_pad / nth;
+    const scope_op_debug_print log("ggml_sycl_op_router_fused", indices, 0);
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    const float * x = (const float *) logits->data;
+    const float * b = (const float *) bias->data;
+    float * p = (float *) probs->data;
+    float * y = (float *) biased->data;
+    int * dst = (int *) indices->data;
+    const sycl::range<3> block_dims(1, 1, nth);
+    const sycl::range<3> block_nums(1, nrows, 1);
+    ctx.stream()->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<uint8_t, 1> scratch(sycl::range<1>(shared_mem), cgh);
+        cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims), [=](sycl::nd_item<3> item) {
+            const int row = item.get_group(1);
+            for (int task = 0; task < tasks_per_thread; ++task) {
+                const int col = item.get_local_id(2) * tasks_per_thread + task;
+                if (col < ncols) {
+                    const int offset = row * ncols + col;
+                    const float v = x[offset];
+                    const float bias_value = b[col];
+                    // Identical to F32 op_sigmoid; same default compiler math.
+                    const float probability = 1.0f / (1.0f + op_exp(-v));
+                    p[offset] = probability;
+                    y[offset] = probability + bias_value;
+                }
+            }
+            // The original sort's local-only barrier cannot publish these USM
+            // writes. Every lane, including padded lanes, reaches this barrier.
+            item.barrier(sycl::access::fence_space::global_and_local);
+            k_argsort_f32_i32<GGML_SORT_ORDER_DESC>(
+                y, dst, ncols, ncols_pad, tasks_per_thread, item,
+                scratch.get_multi_ptr<sycl::access::decorated::no>().get());
+        });
+    });
+    return add_idx + 1 - i;
 }
 
