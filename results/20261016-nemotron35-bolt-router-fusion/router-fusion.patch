+// Bolt's complete sigmoid + bias + descending argsort. Unlike a CPU argsort
+// oracle, the independent same-backend control fixes the bitonic tie order.
+struct test_bolt_router : public test_case {
+    const int64_t experts, tokens;
+    const bool ties;
+    const std::string guard;
+    std::array<ggml_tensor *, 2> input{}, bias_input{}, logits{}, probs{}, biased{}, indices{};
+    std::vector<ggml_tensor *> checked;
+    ggml_gallocr_ptr allocation;
+
+    test_bolt_router(int64_t experts, int64_t tokens, bool ties, const char * guard = "none") :
+        experts(experts), tokens(tokens), ties(ties), guard(guard) {}
+    std::string vars() override { return VARS_TO_STR4(experts, tokens, ties, guard); }
+    std::string op_desc(ggml_tensor *) override { return "BOLT_ROUTER"; }
+    bool run_whole_graph() override { return true; }
+    std::vector<ggml_tensor *> fusion_test_nodes() override {
+        auto result = checked;
+        result.insert(result.end(), sentinels.begin(), sentinels.end());
+        return result;
+    }
+    int64_t rows() const { return tokens * (guard == "dimensions" ? 2 : 1); }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        checked.clear();
+        const auto expand = [&](ggml_tensor * t) {
+            if (mode == MODE_TEST) {
+                ggml_build_forward_expand(gf, t);
+            }
+        };
+        for (int side = 0; side < 2; ++side) {
+            const bool control = side == 1;
+            input[side] = ggml_new_tensor_3d(ctx, GGML_TYPE_F32,
+                experts + (guard == "strided_logits"), tokens, guard == "dimensions" ? 2 : 1);
+            logits[side] = ggml_dup(ctx, input[side]); // preserve signed zero exactly
+            if (guard == "strided_logits") {
+                logits[side] = ggml_view_3d(ctx, logits[side], experts, tokens, 1,
+                    logits[side]->nb[1], logits[side]->nb[2], 0);
+            }
+            ggml_tensor * bias;
+            if (guard == "bias_alias" || guard == "bias_alias_shifted") {
+                bias_input[side] = nullptr;
+                bias = ggml_view_1d(ctx, logits[side], experts,
+                    guard == "bias_alias_shifted" ? experts * sizeof(float) : 0);
+            } else if (guard == "strided_bias") {
+                bias_input[side] = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2, experts);
+                bias = ggml_transpose(ctx, ggml_view_2d(ctx, bias_input[side], 1, experts,
+                    2 * sizeof(float), 0));
+            } else {
+                bias_input[side] = ggml_new_tensor_2d(ctx, GGML_TYPE_F32,
+                    experts, guard == "bias_rows" ? tokens : 1);
+                bias = bias_input[side];
+            }
+            // Prepare all input/view nodes BEFORE the exact three-node window.
+            expand(logits[side]);
+            expand(bias);
+            const bool inplace_sigmoid = guard == "inplace_sigmoid" ||
+                guard == "bias_alias" || guard == "bias_alias_shifted";
+            probs[side] = guard == "wrong_unary" ? ggml_tanh(ctx, logits[side]) :
+                inplace_sigmoid ? ggml_sigmoid_inplace(ctx, logits[side]) : ggml_sigmoid(ctx, logits[side]);
+            expand(probs[side]);
+            ggml_tensor * weight_view = nullptr;
+            if (guard == "model_reshape" || guard == "allocator") {
+                weight_view = ggml_reshape_3d(ctx, probs[side], 1, experts, tokens);
+                expand(weight_view);
+            }
+            if (control || guard == "intervening") {
+                // Executable, output-marked copy, not a view/no-op. The control
+                // still uses the original probabilities, including inplace ADD.
+                ggml_tensor * barrier = ggml_cont(ctx, probs[side]);
+                ggml_set_output(barrier);
+                expand(barrier);
+            }
+            biased[side] = guard == "inplace_add" ? ggml_add_inplace(ctx, probs[side], bias) :
+                ggml_add(ctx, probs[side], bias);
+            if (guard == "reuse_logits_biased") {
+                // Explicit exact-coordinate reuse, as opposed to a shifted view.
+                biased[side]->view_src = logits[side];
+                biased[side]->view_offs = 0;
+            }
+            expand(biased[side]);
+            indices[side] = ggml_argsort(ctx, biased[side],
+                guard == "ascending" ? GGML_SORT_ORDER_ASC : GGML_SORT_ORDER_DESC);
+            if (guard == "reuse_logits_indices" || guard.find("indices_logits_") == 0) {
+                indices[side]->view_src = logits[side];
+                indices[side]->view_offs = 0;
+            }
+            expand(indices[side]);
+            // Materialized values and external consumers must remain supported.
+            ggml_set_output(probs[side]);
+            ggml_set_output(biased[side]);
+            ggml_set_output(indices[side]);
+            ggml_tensor * observed = nullptr;
+            if (weight_view) {
+                observed = ggml_scale(ctx, ggml_cont(ctx, weight_view), 0.5f);
+            } else if (guard == "consumer_probs" || guard == "consumer_biased") {
+                observed = ggml_scale(ctx, ggml_cont(ctx, ggml_view_1d(ctx,
+                    guard == "consumer_probs" ? probs[side] : biased[side], experts, 0)), 0.5f);
+            } else if (guard == "indices_logits_output") {
+                ggml_set_output(logits[side]);
+            } else if (guard == "indices_logits_consumer" || guard == "indices_logits_view") {
+                ggml_tensor * source = logits[side];
+                if (guard == "indices_logits_view") {
+                    source = ggml_view_1d(ctx, source, experts, 0);
+                }
+                // Indices intentionally overwrite the logit storage in this
+                // sequential graph. Amplify its finite I32 bit patterns so the
+                // CPU comparison is meaningful; fusion must decline live reuse.
+                observed = ggml_scale(ctx, ggml_cont(ctx, source), FLT_MAX);
+            }
+            if (observed) {
+                ggml_set_output(observed);
+                expand(observed);
+                checked.push_back(observed);
+            }
+        }
+        const int64_t n = experts * rows();
+        const auto flat = [&](ggml_tensor * t) { return ggml_reshape_1d(ctx, t, n); };
+        ggml_tensor * floats = ggml_concat(ctx,
+            ggml_concat(ctx, flat(probs[0]), flat(biased[0]), 0),
+            ggml_concat(ctx, flat(probs[1]), flat(biased[1]), 0), 0);
+        ggml_set_output(floats);
+        expand(floats);
+        checked.push_back(floats);
+        ggml_tensor * out = ggml_concat(ctx, flat(indices[0]), flat(indices[1]), 0);
+        ggml_set_output(out);
+        checked.push_back(out);
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        if (guard == "allocator") {
+            // test_case normally uses non-reusing context allocation. Exercise
+            // the real gallocr here, without changing the shared test framework.
+            auto buft = ggml_backend_buffer_get_type(input[0]->buffer);
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+                t->data = nullptr;
+                t->buffer = nullptr;
+                t->extra = nullptr;
+                if (t->op == GGML_OP_NONE) {
+                    ggml_set_input(t);
+                    ggml_set_output(t);
+                }
+            }
+            allocation.reset(ggml_gallocr_new(buft));
+            GGML_ASSERT(allocation && ggml_gallocr_alloc_graph(allocation.get(), gf));
+            for (int side = 0; side < 2; ++side) {
+                GGML_ASSERT(probs[side]->data == logits[side]->data);
+                GGML_ASSERT(probs[side]->data != biased[side]->data);
+            }
+            printf("BOLT_ROUTER allocator: logits=probs exact (2 graphs) ");
+        }
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->view_src || (guard == "allocator" && t->op != GGML_OP_NONE)) {
+                continue;
+            }
+            std::vector<float> data(ggml_nelements(t), 0.25f);
+            for (size_t i = 0; i < data.size(); ++i) {
+                if (t == input[0] || t == input[1]) {
+                    const int col = (i % t->ne[0]) % experts;
+                    const int row = i / t->ne[0];
+                    if (ties) {
+                        const float values[] = { -FLT_MAX, -100.0f, -0.0f, +0.0f, 100.0f, FLT_MAX,
+                                                 -FLT_MAX, FLT_MAX };
+                        data[i] = values[(col + row * 8) % 8];
+                    } else {
+                        data[i] = ((col * 37 + row * 17) % experts - experts / 2) * 0.01f;
+                    }
+                } else if (t == bias_input[0] || t == bias_input[1]) {
+                    const int col = (guard == "strided_bias" ? i / 2 : i) % experts;
+                    // p=0,b=1 and p=1,b=0 create exact bias-induced ties.
+                    data[i] = ties ? (col % 8 == 6 ? 1.0f : 0.0f) : col * 0.001f;
+                }
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
+        }
+    }
+
+    double err(const float * a, const float * b, size_t n) override {
+        const size_t count = experts * rows();
+        if (n == 4 * count) {
+            size_t mismatches = 0;
+            for (size_t j = 0; j < 2 * count; ++j) {
+                mismatches += memcmp(a + j, a + 2 * count + j, sizeof(float)) != 0;
+                mismatches += memcmp(b + j, b + 2 * count + j, sizeof(float)) != 0;
+            }
+            printf("BOLT_ROUTER floats: mismatches=%zu ", mismatches);
+            return mismatches ? INFINITY : test_case::err(a, b, n); // unchanged 1e-7 CPU NMSE
+        }
+        if (n != 2 * count) {
+            return test_case::err(a, b, n); // extra consumers and sentinels
+        }
+        // Read actual I32 tensors too: no cast, subset/top-k, or checksum oracle.
+        std::vector<int32_t> ia(count), ic(count);
+        ggml_backend_tensor_get(indices[0], ia.data(), 0, count * sizeof(int32_t));
+        ggml_backend_tensor_get(indices[1], ic.data(), 0, count * sizeof(int32_t));
+        size_t mismatches = 0;
+        for (size_t j = 0; j < count; ++j) {
+            mismatches += ia[j] != ic[j];
+            mismatches += a[j] != a[count + j];
+            mismatches += b[j] != b[count + j];
+        }
+        printf("BOLT_ROUTER indices: mismatches=%zu ", mismatches);
+        if (mismatches) {
+            return INFINITY;
+        }
+        // Existing test_top_k(ties) convention: CPU tie order is unspecified.
+        // Require full permutations and identical ranked values; the stronger
+        // same-backend comparison above still requires EXACT original indices.
+        std::vector<float> scores(count);
+        ggml_backend_tensor_get(biased[1], scores.data(), 0, count * sizeof(float));
+        for (size_t row = 0; row < (size_t) rows(); ++row) {
+            std::vector<bool> seen_a(experts, false), seen_b(experts, false);
+            for (int col = 0; col < experts; ++col) {
+                const size_t pos = row * experts + col;
+                if (a[pos] < 0 || a[pos] >= experts || b[pos] < 0 || b[pos] >= experts ||
+                    a[pos] != (int) a[pos] || b[pos] != (int) b[pos]) {
+                    return INFINITY;
+                }
+                const int x = (int) a[pos], y = (int) b[pos];
+                if (seen_a[x] || seen_b[y] || scores[row * experts + x] != scores[row * experts + y]) {
+                    return INFINITY;
+                }
+                seen_a[x] = seen_b[y] = true;
+                if (col) {
+                    const float previous = scores[row * experts + (int) a[pos - 1]];
+                    const float current = scores[row * experts + x];
+                    if (guard == "ascending" ? previous > current : previous < current) {
+                        return INFINITY;
+                    }
+                }
+            }
+        }
+        return 0.0;
+    }
