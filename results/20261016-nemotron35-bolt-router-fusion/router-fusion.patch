+// Bolt routing only: keep the original shared-memory bitonic network (including
+// its strict tie comparisons and padding). There is no global-sort fusion.
+static int ggml_sycl_router_fused(ggml_backend_sycl_context & ctx, ggml_cgraph * graph, int i) {
+    if (!g_ggml_sycl_enable_fusion || i + 2 >= graph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor * probs = graph->nodes[i];
+    int add_idx = i + 1;
+    // build_moe_ffn visits the raw-probability weight view before the selection
+    // branch. Admit only that exact metadata reshape, never an executable node.
+    const ggml_tensor * view = graph->nodes[add_idx];
+    if (view->op == GGML_OP_RESHAPE && view->src[0] == probs &&
+        view->ne[0] == 1 && view->ne[1] == probs->ne[0] &&
+        view->ne[2] == probs->ne[1] && view->ne[3] == 1) {
+        ++add_idx;
+    }
+    if (add_idx + 1 >= graph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor * biased = graph->nodes[add_idx];
+    ggml_tensor * indices = graph->nodes[add_idx + 1];
+    const int nodes[] = { i, add_idx, add_idx + 1 };
+    const ggml_op ops[] = { GGML_OP_UNARY, GGML_OP_ADD, GGML_OP_ARGSORT };
+    // All three values are materialized, including externally consumed raw
+    // probabilities. Output exceptions still require COMPUTE on every node.
+    if (!ggml_can_fuse_subgraph_ext(graph, nodes, 3, ops, nodes, 3) ||
+        ggml_get_unary_op(probs) != GGML_UNARY_OP_SIGMOID ||
+        biased->src[0] != probs || indices->src[0] != biased ||
+        indices->op_params[0] != GGML_SORT_ORDER_DESC) {
+        return false;
+    }
+    const ggml_tensor * logits = probs->src[0];
+    const ggml_tensor * bias = biased->src[1];
+    const int64_t nc = probs->ne[0];
+    if (!logits || !bias || (nc != 240 && nc != 304 && nc != 368 && nc != 432 && nc != 496) ||
+        probs->ne[1] < 1 || probs->ne[1] > 1024 || probs->ne[2] != 1 || probs->ne[3] != 1) {
+        return false;
+    }
+    for (const ggml_tensor * t : std::array<const ggml_tensor *, 5>{ logits, bias, probs, biased, indices }) {
+        if (!t->data || !t->buffer ||
+            ggml_backend_buffer_get_type(t->buffer) != ggml_backend_sycl_buffer_type(ctx.device) ||
+            t->type != (t == indices ? GGML_TYPE_I32 : GGML_TYPE_F32) || !ggml_is_contiguous(t)) {
+            return false;
+        }
+        if (t == bias ? (t->ne[0] != nc || t->ne[1] != 1 || t->ne[2] != 1 || t->ne[3] != 1) :
+                        !ggml_are_same_shape(t, probs)) {
+            return false;
+        }
+    }
+    const auto overlaps = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const uintptr_t x = (uintptr_t) a->data, y = (uintptr_t) b->data;
+        return x <= y ? y - x < ggml_nbytes(a) : x - y < ggml_nbytes(b);
+    };
+    const auto same_range = [](const ggml_tensor * a, const ggml_tensor * b) {
+        return a->data == b->data && ggml_nbytes(a) == ggml_nbytes(b);
+    };
+    // A lane loads its logit before either store. Exact packed coordinate reuse
+    // is safe; shifted/cross-row reuse is not. The repeated bias is read-only.
+    for (const ggml_tensor * out : { probs, biased, indices }) {
+        if (overlaps(out, bias) || (overlaps(out, logits) && !same_range(out, logits))) {
+            return false;
+        }
+    }
+    if (overlaps(probs, biased) || overlaps(probs, indices) || overlaps(biased, indices)) {
+        // In particular, do not overwrite biased storage inside the unchanged
+        // sorter: its final barrier fences local, not global, memory.
+        return false;
+    }
+    if (overlaps(indices, logits)) {
+        // Indices may reuse a dead, non-view computed logit allocation, after
+        // the global barrier. Never erase an externally visible logit or view.
+        if (logits->op == GGML_OP_NONE || logits->view_src ||
+            (logits->flags & (GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT))) {
+            return false;
+        }
