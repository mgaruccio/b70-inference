+    const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst)
+{
+    const int64_t n = src1->ne[2];
+    if (n != 4 || !ggml_is_contiguous(src1)) return false;
+    // Concurrent token outputs must not alias any parent input.
+    for (const ggml_tensor * t : {src0, src1, ids}) {
+        if (!ggml_sycl_verify_singletons_disjoint(ctx, t, dst)) return false;
+    }
+    // Eligibility already bounds ne10 padding and ne11*n (including quantizer int products).
+    const int padded_cols = GGML_PAD((int) src1->ne[0], MATRIX_ROW_PADDING);
+    const int qrows = (int) (src1->ne[1] * n);
+    const size_t bytes_per_qrow = (size_t) (padded_cols / QK8_1) * sizeof(block_q8_1);
+    // Private candidate: cap live scratch at 1 MiB, with room for pool look-ahead/alignment.
+    const size_t max_q8_bytes = std::min<size_t>(1u << 20,
+        ggml_backend_sycl_buffer_type_get_max_size(src1->buffer->buft) / 2);
+    if (bytes_per_qrow > max_q8_bytes / qrows) return false;
+
+    const queue_ptr stream = ctx.stream();
+    ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool(), (size_t) qrows * bytes_per_qrow);
+    char * src1_ddq = src1_q8_alloc.get();
