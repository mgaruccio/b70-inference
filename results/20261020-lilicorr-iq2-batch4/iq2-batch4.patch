+// Plain IQ2 only. Each token calls the unchanged singleton arithmetic with its own pointers.
+void ggml_sycl_mul_mat_vec_q_id_iq2_batch4(
+    const void * vx_base, const void * vy, const int32_t * ids_dev, float * dst_base,
+    const int ncols, const int nrows, const int n_experts_used, const int n_tokens,
+    const size_t expert_weight_stride, const size_t dst_row_stride, const size_t src1_row_stride,
+    const size_t src1_token_stride, const size_t ids_token_stride, const size_t dst_token_stride,
+    dpct::queue_ptr stream) {
+    GGML_ASSERT(n_tokens >= 2 && n_tokens <= 4);
+    const int            block_num_y = (nrows + GGML_SYCL_MMV_Y - 1) / GGML_SYCL_MMV_Y;
+    const sycl::range<3> block_nums((unsigned) n_tokens, (unsigned) n_experts_used, (unsigned) block_num_y);
+    const sycl::range<3> block_dims(1, GGML_SYCL_MMV_Y, WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const size_t token = item.get_group(0);
+                mul_mat_vec_q_moe<QK_K, QI2_XXS/2, block_iq2_xxs, VDR_IQ2_XXS_Q8_1_MMVQ, vec_dot_iq2_xxs_q8_1_moe>(
+                    vx_base, (const char *) vy + token * src1_token_stride,
+                    (float *) ((char *) dst_base + token * dst_token_stride),
+                    (const int32_t *) ((const char *) ids_dev + token * ids_token_stride),
+                    ncols, nrows, expert_weight_stride, dst_row_stride, src1_row_stride, item);
+            });
+    });
+}
