+void llama_context::init_lilicorr_device_embedding() {
+    // This experiment is only the existing, single-device Q8 shared-table LiliCorr path.
+    if (model.arch != LLM_ARCH_DFLASH || !model.lilicorr_pass_hidden_proj ||
+            model.hparams.lilicorr_candidate_topk == 0) {
+        return;
+    }
+    auto inactive = [](const char * reason) {
+        LLAMA_LOG_INFO("lilicorr_device_embedding: inactive reason=%s\n", reason);
+    };
+    if (model.tok_embd || !cparams.ctx_other || !cparams.op_offload ||
+            model.hparams.vocab_only || model.hparams.no_alloc ||
+            model.n_gpu_layers() == 0 || model.devices.size() != 1) {
+        inactive("not-shared-single-device-offload");
+        return;
+    }
+    auto * source = llama_get_model(cparams.ctx_other)->tok_embd;
+    if (!source || !source->buffer || !source->data ||
+            !ggml_backend_buffer_is_host(source->buffer) || source->extra || source->view_src ||
+            source->op != GGML_OP_NONE || source->type != GGML_TYPE_Q8_0 ||
+            !ggml_is_contiguous(source) || source->ne[2] != 1 || source->ne[3] != 1) {
+        inactive("not-standard-host-q8-table");
+        return;
+    }
+    ggml_backend_t backend = nullptr;
+    for (const auto & item : backends) {
+        auto dev = ggml_backend_get_device(item.get());
+        auto reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+        if (dev == model.devices.front().dev && reg &&
+                ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU &&
+                strcmp(ggml_backend_reg_name(reg), "SYCL") == 0) {
+            backend = item.get();
+            break;
+        }
+    }
+    if (!backend) {
+        inactive("no-sycl-gpu-backend");
+        return;
+    }
+    auto buft = ggml_backend_get_default_buffer_type(backend);
+    // The pinned SYCL allocator may use host USM for >=4 GiB (2 MiB rounded).
+    // Bound this experiment to <=1 GiB, well below that threshold, including padding.
+    if (ggml_backend_buft_is_host(buft) || ggml_nbytes(source) == 0 ||
+            ggml_backend_buft_get_alloc_size(buft, source) > (size_t(1) << 30)) {
+        inactive("unsupported-device-allocation");
+        return;
+    }
+    ggml_context_ptr ctx(ggml_init({ggml_tensor_overhead(), nullptr, true}));
+    if (!ctx) {
+        throw std::runtime_error("LiliCorr device embedding metadata allocation failed");
+    }
+    auto * copy = ggml_dup_tensor(ctx.get(), source);
+    ggml_set_name(copy, "lilicorr.shared_token_embd");
+    {
+        ggml_context_ptr probe(ggml_init({2 * ggml_tensor_overhead(), nullptr, true}));
+        if (!probe) {
+            throw std::runtime_error("LiliCorr device embedding probe allocation failed");
+        }
+        auto * ids = ggml_new_tensor_1d(probe.get(), GGML_TYPE_I32, 1);
+        auto * rows = ggml_get_rows(probe.get(), copy, ids);
+        if (!ggml_backend_dev_supports_op(ggml_backend_get_device(backend), rows)) {
+            inactive("get-rows-unsupported");
+            return;
+        }
+    }
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft));
+    if (!buffer) {
+        // No silent OOM fallback: a failed candidate must not be timed as optimized.
+        throw std::runtime_error("LiliCorr device embedding buffer allocation failed");
+    }
+    ggml_backend_buffer_set_usage(buffer.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    // dup + native allocation creates fresh backend extras (no copied reorder state).
+    // Only GET_ROWS consumes this copy, so the MUL_MAT-only lazy reorder never runs.
+    ggml_backend_tensor_copy(source, copy);
+    // SYCL set_tensor can stage async uploads on the default buffer queue, distinct
+    // from the compute queue drained by backend_synchronize. Native blocking get
+    // on that same in-order default queue fences the entire upload before publishing.
+    uint8_t ready = 0;
+    ggml_backend_tensor_get(copy, &ready, 0, sizeof(ready));
+    if (ready != *static_cast<const uint8_t *>(source->data)) {
+        throw std::runtime_error("LiliCorr device embedding upload failed");
+    }
+    lilicorr_embd_ctx = std::move(ctx);
+    lilicorr_embd_buf = std::move(buffer);
+    cparams.lilicorr_tok_embd = copy;
+    LLAMA_LOG_INFO("lilicorr_device_embedding: active backend=%s buffer=%s type=%s tensor_bytes=%zu buffer_bytes=%zu\n",
+            ggml_backend_name(backend), ggml_backend_buffer_name(lilicorr_embd_buf.get()),
+            ggml_type_name(copy->type), ggml_nbytes(copy), ggml_backend_buffer_get_size(lilicorr_embd_buf.get()));
