+                                    } else if (head % 4 == 2) {
+                                        f = input.role == 1 ? 16777216.0f : input.role == 2 ? 1.0f : -16777215.0f;
+                                    }
+                                }
+                                GGML_ASSERT(index < data.size());
+                                data[index] = f;
+                            }
+                        }
+                    }
+                }
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
+        }
+        if (reuse_dst) {
+            // Simulate graph-allocator reuse after initialization, without changing
