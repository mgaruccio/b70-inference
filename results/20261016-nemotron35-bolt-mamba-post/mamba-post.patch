+                z = ggml_view_4d(ctx, z_storage, hd, nh, n_tokens, ns, zrow, zs, zs * n_tokens, 128 * sizeof(float));
+            }
+            ggml_tensor * x_storage = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, xs / sizeof(float) * n_tokens * ns + 64);
+            ggml_tensor * x = ggml_view_4d(ctx, x_storage, hd, nh, n_tokens, ns, xrow, xs, xs * n_tokens, 64 * sizeof(float));
+            ggml_tensor * d_storage = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, guard == "strided_d" ? 2 : 1, nh, 1, 1);
+            ggml_tensor * d = d_storage;
