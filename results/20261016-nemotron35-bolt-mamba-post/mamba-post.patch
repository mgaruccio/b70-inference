+// Mamba2 post-scan: keep MUL and ADD rounding identical to the separate kernels.
+static void ggml_sycl_op_mamba_post(ggml_backend_sycl_context & ctx, const ggml_tensor * z,
+                                    const ggml_tensor * x, const ggml_tensor * d,
+                                    const ggml_tensor * y, const ggml_tensor * cont, const ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/2);
+    const float * zp = (const float *) z->data;
+    const float * xp = (const float *) x->data;
+    const float * dp = (const float *) d->data;
+    const float * yp = (const float *) y->data;
+    float * out = (float *) dst->data;
+    float * out_z = (float *) cont->data;
+    const size_t zs = z->nb[2] / sizeof(float);
+    const size_t xs = x->nb[2] / sizeof(float);
+    const size_t n = (size_t) ggml_nelements(dst);
+    constexpr size_t block = 256;
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    ctx.stream()->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(((n + block - 1) / block) * block), sycl::range<1>(block)),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+#pragma clang fp contract(off) reassociate(off)
+            const size_t i = item.get_global_id(0);
+            if (i >= n) {
+                return;
+            }
+            const size_t token = i / (64 * 128);
+            const size_t col = i % (64 * 128);
+            volatile float product = xp[token * xs + col] * dp[col / 64];
+            const float sum = yp[i] + product;
+            const float z_value = zp[token * zs + col];
+            out_z[i] = z_value;
+            out[i] = sum; // Leave SwiGLU in its original kernel/compiler context.
+        });
+}
