+            const size_t yrow = (hd + (guard == "strided_y")) * sizeof(float);
+            const size_t zs = 74240;
+            const size_t xs = guard == "inplace_mul" ? hd * nh * sizeof(float) : 40960;
+            const size_t ys = yrow * nh;
+            ggml_tensor * z_storage;
+            ggml_tensor * z;
+            if (guard == "alias_leaf") {
+                z_storage = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, hd, nh, n_tokens, ns);
+                z = z_storage; // a direct GGML_OP_NONE input, not a view
+            } else {
