+// Return the number of following nodes consumed, or zero for the unchanged eager path.
+int ggml_sycl_mamba_post_fused(ggml_backend_sycl_context & ctx, const ggml_cgraph * graph, int i) {
+    const auto reject = [&](int line) {
+        const ggml_tensor * t = i >= 0 && i < graph->n_nodes ? graph->nodes[i] : nullptr;
+        if (t && t->ne[0] == 64 && t->ne[1] == 128) { GGML_SYCL_DEBUG("MAMBA_POST_REJECT %s line=%d\n", t->name, line); }
+        return 0;
+    };
+    if (!g_ggml_sycl_enable_fusion || i < 0 || i > graph->n_nodes - 4 ||
+        graph->nodes[i]->op != GGML_OP_CONT) {
+        return reject(__LINE__);
+    }
+    // Only the optional y VIEW may intervene. Never skip another executable op.
+    const bool has_view = graph->nodes[i + 1]->op == GGML_OP_VIEW;
+    const int m = i + 1 + (int) has_view;
+    if (m > graph->n_nodes - 3) {
+        return reject(__LINE__);
+    }
+    const int idxs[] = { i, m, m + 1, m + 2 };
+    const ggml_op ops[] = { GGML_OP_CONT, GGML_OP_MUL, GGML_OP_ADD, GGML_OP_GLU };
+    const int outputs[] = { m + 2 };
+    // y's VIEW is an external input, NOT an elided node. Its source may be a live
+    // SSM_SCAN result, and its output flag/other consumers must remain usable.
+    if (!ggml_can_fuse_subgraph_ext(graph, idxs, 4, ops, outputs, 1)) {
+        return reject(__LINE__);
+    }
+    const ggml_tensor * cont = graph->nodes[i];
+    const ggml_tensor * mul = graph->nodes[m];
+    const ggml_tensor * add = graph->nodes[m + 1];
+    ggml_tensor * glu = graph->nodes[m + 2];
+    const ggml_tensor * z = cont->src[0];
+    const ggml_tensor * x = mul->src[0];
+    const ggml_tensor * d = mul->src[1];
+    const ggml_tensor * y = add->src[0];
+    if (!z || !x || !d || !y || add->src[1] != mul || glu->src[0] != cont || glu->src[1] != add ||
+        (has_view && graph->nodes[i + 1] != y) || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU ||
+        ggml_get_op_params_i32(glu, 1) != 0) {
+        return reject(__LINE__);
+    }
+    // All four reads must come from outside the elided subgraph. For example,
+    // MUL(CONT(z), D) has valid internal use counts but cannot read the elided CONT.
+    for (const ggml_tensor * input : { z, x, d, y }) {
+        for (int idx : idxs) {
+            if (input == graph->nodes[idx] || input->view_src == graph->nodes[idx]) {
+                return reject(__LINE__);
+            }
+        }
+    }
+    // Elided in-place writes are observable through their view sources.
+    for (int j = 0; j < 4; ++j) {
+        const ggml_tensor * t = graph->nodes[idxs[j]];
+        if (j < 3 && t->view_src) {
+            return reject(__LINE__);
+        }
+        for (int s = (j == 0 ? 1 : 2); s < GGML_MAX_SRC; ++s) {
+            if (t->src[s]) {
+                return reject(__LINE__);
+            }
+        }
+    }
+    if (glu->type != GGML_TYPE_F32 || glu->ne[0] != 64 || glu->ne[1] != 128 ||
+        glu->ne[2] < 1 || glu->ne[2] > 1024 || glu->ne[3] != 1) {
+        return reject(__LINE__);
+    }
+    for (const ggml_tensor * t : { cont, mul, add, (const ggml_tensor *) glu, y, x, z }) {
+        if (t->type != GGML_TYPE_F32 || !ggml_are_same_shape(t, glu)) {
+            return reject(__LINE__);
+        }
+        if (t == x || t == z) {
+            // Rows/heads are packed; only the token stride may have padding.
+            // Bound the full stride product before either nbytes or kernel indexing.
+            if (t->nb[0] != sizeof(float) || t->nb[1] != 64 * sizeof(float) ||
+                t->nb[2] < 64 * 128 * sizeof(float) || t->nb[2] % sizeof(float) != 0 ||
+                t->nb[2] > SIZE_MAX / (size_t) t->ne[2] || t->nb[3] != t->nb[2] * t->ne[2]) {
+                return reject(__LINE__);
+            }
+        } else if (!ggml_is_contiguous(t)) {
+            return reject(__LINE__);
+        }
+    }
+    if (d->type != GGML_TYPE_F32 || d->ne[0] != 1 || d->ne[1] != 128 ||
+        d->ne[2] != 1 || d->ne[3] != 1 || !ggml_is_contiguous(d)) {
+        return reject(__LINE__);
+    }
+    // Bound ranges including GGML_OP_NONE leaves. The later GLU is not fused;
+    // overlap checks below protect the actual CONT and ADD destinations.
+    const auto range = [](const ggml_tensor * t, uintptr_t & begin, uintptr_t & end) {
+        begin = (uintptr_t) t->data;
+        const size_t bytes = ggml_nbytes(t); // shape/stride products bounded above
+        if (!begin || begin % alignof(float) != 0 || bytes > UINTPTR_MAX - begin) {
+            return false;
+        }
+        end = begin + bytes;
+        return true;
+    };
+    uintptr_t out_begin, out_end;
+    if (!range(glu, out_begin, out_end)) {
+        return reject(__LINE__);
+    }
+    // This narrower fusion materializes CONT and ADD, then runs the original GLU.
+    // Protect both actual destinations; the later GLU retains its own eager alias semantics.
+    uintptr_t cont_begin, cont_end, add_begin, add_end;
+    if (!range(cont, cont_begin, cont_end) || !range(add, add_begin, add_end) ||
+        (cont_begin < add_end && add_begin < cont_end)) {
+        return reject(__LINE__);
+    }
+    for (const ggml_tensor * t : { z, x, d, y }) {
+        uintptr_t begin, end;
+        if (!range(t, begin, end)) {
+            return reject(__LINE__);
+        }
+        // CONT may only reuse its own packed input. ADD may reuse a packed
+        // elementwise input: every work-item reads that coordinate before writing.
+        // Repeated D values, shifted overlaps and strided compression stay rejected.
+        const bool packed = ggml_is_contiguous(t) && ggml_are_same_shape(t, add);
+        if ((cont_begin < end && begin < cont_end) &&
+            !(t == z && packed && begin == cont_begin && end == cont_end)) {
+            return reject(__LINE__);
+        }
+        if ((add_begin < end && begin < add_end) &&
+            !(packed && begin == add_begin && end == add_end)) {
+            return reject(__LINE__);
+        }
+    }
+    ggml_sycl_op_mamba_post(ctx, z, x, d, y, cont, add);
+    return m + 1 - i; // GLU is deliberately not skipped.
+}
