+// Private n=4 submission: adjacent groups share a weight row pair, not SLM.
+// Group execution order/cache residency is unspecified; every group is independent.
+template <int WG>
+static void q8_0_esimd_launch_batch4(const void * vx, const float * y, float * dst, const int ncols,
+                                    const int nrows, const size_t src1_stride, const size_t dst_stride,
+                                    dpct::queue_ptr stream) {
+    const size_t workgroups = ((size_t) nrows + 1) / 2 * 4;
+    stream->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> lmem(sycl::range<1>(WG * 2), h);
+        h.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>(workgroups * WG), sycl::range<1>(WG)),
+            [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+                const size_t group = it.get_group(0);
+                const size_t token = group % 4;
+                const int row_pair = (int) (group / 4);
+                dequantize_mul_mat_vec_q8_0_reorder_esimd<WG>(
+                    vx, y + token * src1_stride, dst + token * dst_stride,
+                    ncols, nrows, lmem, it, row_pair);
+            });
+    });
+}
