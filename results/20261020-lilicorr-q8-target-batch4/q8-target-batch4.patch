+// Caller retains the private tensor/layout/scope eligibility and allocation bounds.
+// A false return is possible only before submission; enqueue failures propagate.
+bool ggml_sycl_op_dequantize_mul_mat_vec_q8_0_batch4(
+    const void * vx, const float * y, float * dst, const int64_t ncols,
+    const int64_t row_low, const int64_t row_high,
+    const int64_t src1_stride, const int64_t dst_stride,
+    const dpct::queue_ptr & stream, int & launched_wg) {
+#ifdef GGML_SYCL_DMMV_HAS_ESIMD
+    if (!vx || !y || !dst || !stream ||
+        (uintptr_t) vx % 16 != 0 || (uintptr_t) y % sizeof(float) != 0 ||
+        (uintptr_t) dst % sizeof(float) != 0 ||
+        ncols <= 0 || ncols > INT_MAX || ncols % QK8_0 != 0 ||
+        row_low < 0 || row_high <= row_low || row_high - row_low > INT_MAX - 1 ||
+        src1_stride != ncols || dst_stride < row_high - row_low) return false;
+
+    const size_t nrows = (size_t) (row_high - row_low);
+    const size_t nblk_row = (size_t) ncols / QK8_0;
+    // Bound every byte offset before multiplying, including all four columns.
+    const size_t max_bytes = PTRDIFF_MAX;
+    if ((uint64_t) src1_stride > max_bytes / sizeof(float) / 4 ||
+        (uint64_t) dst_stride > max_bytes / sizeof(float) / 4 ||
+        nrows > max_bytes / sizeof(block_q8_0) / nblk_row ||
+        (nrows + 1) / 2 > SIZE_MAX / 4 / 8) return false;
+    const size_t vx_bytes = nrows * nblk_row * sizeof(block_q8_0);
+    const size_t y_bytes = 4 * (size_t) src1_stride * sizeof(float);
+    const size_t dst_bytes = (3 * (size_t) dst_stride + nrows) * sizeof(float);
+    const uintptr_t vx_base = (uintptr_t) vx;
+    const uintptr_t y_base = (uintptr_t) y;
+    const uintptr_t dst_base = (uintptr_t) dst;
+    if (vx_bytes > UINTPTR_MAX - vx_base || y_bytes > UINTPTR_MAX - y_base ||
+        dst_bytes > UINTPTR_MAX - dst_base) return false;
+    // Concurrent writes must not overlap either input, even across columns.
+    if (!(vx_base + vx_bytes <= dst_base || dst_base + dst_bytes <= vx_base) ||
+        !(y_base + y_bytes <= dst_base || dst_base + dst_bytes <= y_base)) return false;
+
+    // Exactly the native thresholds; each selected kernel retains local WG and SLM.
+    int wg;
+    if (nblk_row >= 64) {
+        q8_0_esimd_launch_batch4<8>(vx, y, dst, (int) ncols, (int) nrows, src1_stride, dst_stride, stream);
+        wg = 8;
+    } else if (nblk_row >= 32) {
+        q8_0_esimd_launch_batch4<4>(vx, y, dst, (int) ncols, (int) nrows, src1_stride, dst_stride, stream);
+        wg = 4;
+    } else if (nblk_row >= 16) {
+        q8_0_esimd_launch_batch4<2>(vx, y, dst, (int) ncols, (int) nrows, src1_stride, dst_stride, stream);
+        wg = 2;
+    } else {
+        q8_0_esimd_launch_batch4<1>(vx, y, dst, (int) ncols, (int) nrows, src1_stride, dst_stride, stream);
+        wg = 1;
+    }
+    launched_wg = wg;
+    return true;
+#else
+    GGML_UNUSED(vx); GGML_UNUSED(y); GGML_UNUSED(dst); GGML_UNUSED(ncols);
+    GGML_UNUSED(row_low); GGML_UNUSED(row_high);
+    GGML_UNUSED(src1_stride); GGML_UNUSED(dst_stride); GGML_UNUSED(stream); GGML_UNUSED(launched_wg);
+    return false;
+#endif
+}
 
