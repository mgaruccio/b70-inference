+    def _forward_xpu(self, positions: torch.Tensor, qkv: torch.Tensor) -> torch.Tensor:
+        q, k, v = qkv.split((self.q_size, self.kv_size, self.kv_size), dim=-1)
+        cs = self._cos_sin()
+        cos_sin = None if cs is None else cs.index_select(0, positions)[:, None, :]
+
+        def normalize_rotate(x: torch.Tensor, norm: RMSNorm) -> torch.Tensor:
+            x = x.unflatten(-1, (-1, self.head_dim)).float()
+            x = norm.normalize_xpu(x).to(qkv.dtype)
+            if cos_sin is not None:
+                cos, sin = cos_sin.chunk(2, dim=-1)
+                a, b = x.float().chunk(2, dim=-1)
+                x = torch.cat((a * cos - b * sin, b * cos + a * sin), dim=-1)
+                x = x.to(qkv.dtype)
+            return x.flatten(-2)
+
+        q = normalize_rotate(q, self.q_norm)
+        k = normalize_rotate(k, self.k_norm)
+        # Attention owns the KV update and preserves the layer's window and sinks.
+        attn_output = self.attn(q, k, v.contiguous())
+        output, _ = self.o_proj(attn_output)
+        return output
